<!-- Modal Cliente Iniciar sesión -->
<div class="modal fade modal-login" id="_LoginCliente" tabindex="-1" aria-labelledby="_LoginClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-login-banner">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                <div class="modal-login-icon-box">
                    <i class="bi bi-bag-heart"></i>
                </div>
                <h4 class="modal-login-title" id="_LoginClienteLabel">¡Hola de nuevo!</h4>
                <p class="modal-login-subtitle">Ingresa para realizar tus compras y ver tus domicilios</p>
            </div>
            <div class="modal-login-body">
                <div class="modal-login-alert-container">
                    @if (TempData["Error"] != null && TempData["AbrirModal"]?.ToString() == "_LoginCliente")
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3 small rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-6 flex-shrink-0"></i>
                            <div>@TempData["Error"]</div>
                        </div>
                    }
                </div>
                <form class="modal-login-form" method="post" asp-controller="Account" asp-action="Login">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rolEsperado" value="Cliente" />
                    <div class="mb-3">
                        <label for="client-user" class="form-label">Correo Electrónico</label>
                        <div class="input-group-custom">
                            <i class="bi bi-envelope input-icon"></i>
                            <input type="email" class="form-control" id="client-user" name="email" placeholder="tu-correo@ejemplo.com" required autocomplete="email" pattern="^[a-zA-Z0-9._%+-]+@@[a-zA-Z0-9.-]+\.(com|co|org|net|edu|gov|es|io|[a-zA-Z]{2,})$" title="Ejemplo: correo@@dominio.com o .co">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="client-pass" class="form-label">Contraseña</label>
                        <div class="input-group-custom">
                            <i class="bi bi-lock input-icon"></i>
                            <input type="password" class="form-control" id="client-pass" name="password" placeholder="••••••••" required minlength="8" maxlength="25" autocomplete="current-password">
                            <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility('client-pass', this)" title="Ver contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberClient">
                            <label class="form-check-label small text-muted" for="rememberClient">Recordarme</label>
                        </div>
                        <a href="#" class="text-decoration-none small fw-semibold text-primary">¿Olvidaste tu clave?</a>
                    </div>
                    <button type="submit" class="btn btn-login-submit">
                        <span>Ingresar</span>
                        <i class="bi bi-arrow-right-short fs-4"></i>
                    </button>
                </form>
            </div>
            <div class="modal-login-footer">
                ¿Aún no tienes cuenta? <a href="#" class="fw-bold text-primary text-decoration-none ms-1" data-bs-toggle="modal" data-bs-target="#_RegistroCliente">Regístrate aquí</a>
            </div>
        </div>
    </div>
</div>

<!-- Modal Cliente Registro -->
<div class="modal fade modal-login" id="_RegistroCliente" tabindex="-1" aria-labelledby="_RegistroClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-login-banner">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                <div class="modal-login-icon-box">
                    <i class="bi bi-person-plus"></i>
                </div>
                <h4 class="modal-login-title" id="_RegistroClienteLabel">Crear Cuenta</h4>
                <p class="modal-login-subtitle">Regístrate para realizar tus compras y domicilios</p>
            </div>
            <div class="modal-login-body">
                <div class="modal-login-alert-container">
                    @if (TempData["Error"] != null && TempData["AbrirModal"]?.ToString() == "_RegistroCliente")
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3 small rounded-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-6 flex-shrink-0"></i>
                            <div>@TempData["Error"]</div>
                        </div>
                    }
                </div>
                <form class="modal-login-form" method="post" asp-controller="Account" asp-action="Register">
                    @Html.AntiForgeryToken()
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="reg-name" class="form-label">Nombre</label>
                            <div class="input-group-custom">
                                <i class="bi bi-person input-icon"></i>
                                <input type="text" class="form-control" id="reg-name" name="nombre" placeholder="Juan" required minlength="2" maxlength="100" autocomplete="given-name">
                            </div>
                        </div>
                        <div class="col-6">
                            <label for="reg-apellido" class="form-label">Apellido</label>
                            <div class="input-group-custom">
                                <i class="bi bi-person input-icon"></i>
                                <input type="text" class="form-control" id="reg-apellido" name="apellido" placeholder="Pérez" required minlength="2" maxlength="100" autocomplete="family-name">
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="reg-email" class="form-label">Correo Electrónico</label>
                        <div class="input-group-custom">
                            <i class="bi bi-envelope input-icon"></i>
                            <input type="email" class="form-control" id="reg-email" name="email" placeholder="tu-correo@ejemplo.com" required autocomplete="email" pattern="^[a-zA-Z0-9._%+-]+@@[a-zA-Z0-9.-]+\.(com|co|org|net|edu|gov|es|io|[a-zA-Z]{2,})$" title="El correo debe contener '@@', un dominio y extensión como .com o .co">
                        </div>
                        <small class="text-muted" style="font-size: 11px;">Formato requerido: usuario@@dominio.com o .co</small>
                    </div>
                    <div class="mb-3">
                        <label for="reg-pass" class="form-label">Contraseña</label>
                        <div class="input-group-custom">
                            <i class="bi bi-lock input-icon"></i>
                            <input type="password" class="form-control" id="reg-pass" name="password" placeholder="••••••••" required minlength="6" maxlength="255" autocomplete="new-password">
                            <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility('reg-pass', this)" title="Ver contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="acceptTerms" required>
                            <label class="form-check-label small text-muted" for="acceptTerms">
                                Acepto los <a href="#" class="text-primary text-decoration-none fw-semibold">términos y políticas de privacidad</a>
                            </label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-login-submit">
                        <span>Crear Mi Cuenta</span>
                        <i class="bi bi-arrow-right-short fs-4"></i>
                    </button>
                </form>
            </div>
            <div class="modal-login-footer">
                ¿Ya tienes cuenta? <a href="#" class="fw-bold text-primary text-decoration-none ms-1" data-bs-toggle="modal" data-bs-target="#_LoginCliente">Inicia sesión aquí</a>
            </div>
        </div>
    </div>
</div>

<!-- Modal Repartidor -->
