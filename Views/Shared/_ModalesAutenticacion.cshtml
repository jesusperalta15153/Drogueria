            </div>
            <div class="modal-login-footer">
                <i class="bi bi-lock-fill me-1 text-primary"></i> Área restringida únicamente a personal autorizado
            </div>
        </div>
    </div>
</div>

<!-- Scripts de Funcionamiento de Modales de Autenticación -->
<script>
    // Mostrar u ocultar contraseña
    function togglePasswordVisibility(inputId, btn) {
        var input = document.getElementById(inputId);
        if (!input) return;
        var icon = btn ? btn.querySelector('i') : null;
        if (input.type === 'password') {
            input.type = 'text';
            if (icon) {
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            }
        } else {
            input.type = 'password';
            if (icon) {
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        // Auto-cerrar alertas dismissibles
        document.querySelectorAll(".alert-dismissible").forEach(function (alertEl) {
            setTimeout(function () {
                var instancia = bootstrap.Alert.getOrCreateInstance(alertEl);
                instancia.close();
            }, 4500);
        });

        // Abrir modal si el servidor lo especificó en TempData
        @if (TempData["AbrirModal"] != null)
        {
            <text>
            var serverModalId = "@TempData["AbrirModal"]";
            var serverModalEl = document.getElementById(serverModalId);
            if (serverModalEl && typeof bootstrap !== "undefined") {
                bootstrap.Modal.getOrCreateInstance(serverModalEl).show();
            }
            </text>
        }

        // Envío AJAX de formularios de login para evitar recargas completas o redirecciones erróneas
        document.querySelectorAll(".modal-login-form").forEach(function (form) {
            form.addEventListener("submit", async function (e) {
                e.preventDefault();

                var submitBtn = form.querySelector("button[type='submit']");
                var originalHtml = submitBtn ? submitBtn.innerHTML : "";
                var bodyEl = form.closest(".modal-login-body");
                var alertContainer = bodyEl ? bodyEl.querySelector(".modal-login-alert-container") : null;

                if (alertContainer) alertContainer.innerHTML = "";

                if (submitBtn) {
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span><span>Verificando...</span>';
                }

                try {
                    var formData = new FormData(form);
                    var response = await fetch(form.action, {
                        method: "POST",
                        body: formData,
                        headers: {
                            "X-Requested-With": "XMLHttpRequest",
                            "Accept": "application/json"
                        }
                    });

                    var data = await response.json();

                    if (data.success) {
                        if (data.redirectUrl) {
                            window.location.href = data.redirectUrl;
                            return;
                        }
                        if (data.openModal) {
                            var currentModalEl = form.closest(".modal");
                            if (currentModalEl && typeof bootstrap !== "undefined") {
                                bootstrap.Modal.getInstance(currentModalEl)?.hide();
                            }
                            var targetModalEl = document.getElementById(data.openModal);
                            if (targetModalEl && typeof bootstrap !== "undefined") {
                                var targetAlert = targetModalEl.querySelector(".modal-login-alert-container");
                                if (targetAlert && data.message) {
                                    targetAlert.innerHTML = `
                                        <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2 px-3 small rounded-3" role="alert">
                                            <i class="bi bi-check-circle-fill text-success fs-6 flex-shrink-0"></i>
                                            <div>${data.message}</div>
                                        </div>`;
                                }
                                bootstrap.Modal.getOrCreateInstance(targetModalEl).show();
                            }
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = originalHtml;
                            }
                            return;
                        }
                    } else {
                        if (alertContainer) {
                            alertContainer.innerHTML = `
                                <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3 small rounded-3" role="alert">
                                    <i class="bi bi-exclamation-triangle-fill text-danger fs-6 flex-shrink-0"></i>
                                    <div>${data.message || "Por favor, valide si el usuario o la contraseña son correctos."}</div>
                                </div>`;
                        }
                        var passInput = form.querySelector("input[type='password']");
                        if (passInput) {
                            passInput.value = "";
                            passInput.focus();
                        }
                    }
                } catch (err) {
                    form.submit();
                    return;
                } finally {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalHtml;
                    }
                }
            });
        });
    });
</script>
