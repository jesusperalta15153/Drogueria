@using System.Security.Claims
@using System.Text.Json
@using Drogueria.Models
@{
    var activeNav = (ViewData["ActiveNav"]?.ToString() ?? "catalogo").ToLower();
    var userName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : "Cliente";
    var userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? "";
    var initials = !string.IsNullOrEmpty(userName) && userName.Length >= 2
        ? userName.Substring(0, 2).ToUpper()
        : "CL";
    var esRepartidor = User.IsInRole("Repartidor");

    // Obtener cantidad de items en el carrito desde la sesión (solo para clientes)
    int carritoCount = 0;
    if (!esRepartidor)
    {
        try
        {
            var sessionJson = Context.Session.GetString("Carrito");
            if (!string.IsNullOrEmpty(sessionJson))
            {
                var items = JsonSerializer.Deserialize<List<CarritoItem>>(sessionJson);
                carritoCount = items?.Sum(i => i.Cantidad) ?? 0;
            }
        }
        catch { }
    }
}
<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FarmaVida Tienda Online</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logodrogueria.svg" />

    <script>
        // Carga inmediata de tema para evitar parpadeo blanco (FOUC)
        (function () {
            const savedTheme = localStorage.getItem('app_theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site & Tienda Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tienda.css" asp-append-version="true" />
</head>
<body class="cliente-body">

    <!-- TOPBAR NAVBAR EXCLUSIVO CLIENTE (SIN SIDEBAR) -->
    <header class="cliente-navbar-wrap">
        <nav class="cliente-navbar container-fluid px-3 px-lg-5">
            <!-- Brand Logo -->
            <a asp-controller="Tienda" asp-action="Catalogo" class="cliente-brand">
                <div class="cliente-brand-logo">
                    <img src="~/img/logodrogueria.svg" alt="FarmaVida" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                    <div class="cliente-brand-fallback" style="display:none;">
                        <i class="bi bi-capsule"></i>
                    </div>
                </div>
                <div class="cliente-brand-info">
                    <span class="cliente-brand-title">FarmaVida</span>
                    <span class="cliente-brand-badge">Tienda Online</span>
                </div>
            </a>

            <!-- Navigation Links (Desktop) -->
            <div class="cliente-nav-links d-none d-md-flex">
                @if (esRepartidor)
                {
                    <a asp-controller="Repartidor" asp-action="MisDomicilios" class="cliente-nav-item @(activeNav == "misdomicilios" ? "active" : "")">
                        <i class="bi bi-truck"></i>
                        <span>Mis Domicilios</span>
                    </a>
                    <a asp-controller="Repartidor" asp-action="Historial" class="cliente-nav-item @(activeNav == "historial" ? "active" : "")">
                        <i class="bi bi-clock-history"></i>
                        <span>Historial</span>
                    </a>
                    <a asp-controller="Account" asp-action="Perfil" class="cliente-nav-item @(activeNav == "perfil" ? "active" : "")">
                        <i class="bi bi-person-circle"></i>
                        <span>Mi Perfil</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Tienda" asp-action="Catalogo" class="cliente-nav-item @(activeNav == "catalogo" ? "active" : "")">
                        <i class="bi bi-grid-fill"></i>
                        <span>Catálogo</span>
                    </a>
                    <a asp-controller="Tienda" asp-action="Carrito" class="cliente-nav-item @(activeNav == "carrito" ? "active" : "") position-relative">
                        <i class="bi bi-cart3"></i>
                        <span>Carrito</span>
                        <span id="navCartBadge" class="cliente-cart-badge @(carritoCount > 0 ? "visible" : "")">@carritoCount</span>
                    </a>
                    <a asp-controller="Tienda" asp-action="MisPedidos" class="cliente-nav-item @(activeNav == "pedidos" ? "active" : "")">
                        <i class="bi bi-bag-check-fill"></i>
                        <span>Mis Pedidos</span>
                    </a>
                    <a asp-controller="Account" asp-action="Perfil" class="cliente-nav-item @(activeNav == "perfil" ? "active" : "")">
                        <i class="bi bi-person-circle"></i>
                        <span>Mi Perfil</span>
                    </a>
                }
            </div>

            <!-- Right Actions -->
            <div class="cliente-nav-actions">
                <!-- Theme toggle -->
                <button class="cliente-icon-btn" id="themeToggleBtn" type="button" title="Cambiar tema claro / oscuro" aria-label="Cambiar tema">
                    <i class="bi bi-moon-stars" id="themeIcon"></i>
                </button>

                <!-- User Dropdown -->
                <div class="dropdown">
                    <button class="cliente-user-btn dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="cliente-avatar">@initials</div>
                        <div class="cliente-user-meta d-none d-lg-flex flex-column text-start">
                            <span class="cliente-user-name">@userName</span>
                            <span class="cliente-user-role">@(esRepartidor ? "Repartidor" : "Cliente")</span>
                        </div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end cliente-dropdown shadow-lg border-0 rounded-4 p-2" aria-labelledby="userDropdown">
                        <li class="px-3 py-2 border-bottom mb-1">
                            <div class="fw-bold small text-truncate">@userName</div>
                            <div class="text-muted small text-truncate" style="font-size: 11px;">@userEmail</div>
                        </li>
                        @if (esRepartidor)
                        {
                            <li>
                                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" asp-controller="Repartidor" asp-action="MisDomicilios">
                                    <i class="bi bi-truck text-warning"></i> Mis Domicilios
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" asp-controller="Repartidor" asp-action="Historial">
                                    <i class="bi bi-clock-history text-primary"></i> Historial
                                </a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" asp-controller="Tienda" asp-action="Catalogo">
                                    <i class="bi bi-grid text-primary"></i> Catálogo
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" asp-controller="Tienda" asp-action="Carrito">
                                    <i class="bi bi-cart3 text-primary"></i> Mi Carrito
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" asp-controller="Tienda" asp-action="MisPedidos">
                                    <i class="bi bi-bag-check text-primary"></i> Mis Pedidos
                                </a>
                            </li>
                        }
                        <li>
                            <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2 @(activeNav == "perfil" ? "active text-primary fw-bold" : "")" asp-controller="Account" asp-action="Perfil">
                                <i class="bi bi-person-circle text-primary"></i> Mi Perfil
                            </a>
                        </li>
                        <li><hr class="dropdown-divider my-1"></li>
                        <li>
                            <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="dropdown-item rounded-3 py-2 text-danger d-flex align-items-center gap-2">
                                    <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>

                <!-- Mobile menu hamburger -->
                <button class="cliente-icon-btn d-md-none" id="mobileMenuBtn" type="button" aria-label="Abrir menú">
                    <i class="bi bi-list fs-4"></i>
                </button>
            </div>
        </nav>

        <!-- Mobile Drawer Menu -->
        <div class="cliente-mobile-drawer" id="mobileDrawer">
            <div class="cliente-mobile-nav">
                @if (esRepartidor)
                {
                    <a asp-controller="Repartidor" asp-action="MisDomicilios" class="cliente-mobile-item @(activeNav == "misdomicilios" ? "active" : "")">
                        <i class="bi bi-truck"></i> Mis Domicilios
                    </a>
                    <a asp-controller="Repartidor" asp-action="Historial" class="cliente-mobile-item @(activeNav == "historial" ? "active" : "")">
                        <i class="bi bi-clock-history"></i> Historial
                    </a>
                    <a asp-controller="Account" asp-action="Perfil" class="cliente-mobile-item @(activeNav == "perfil" ? "active" : "")">
                        <i class="bi bi-person-circle"></i> Mi Perfil
                    </a>
                }
                else
                {
                    <a asp-controller="Tienda" asp-action="Catalogo" class="cliente-mobile-item @(activeNav == "catalogo" ? "active" : "")">
                        <i class="bi bi-grid-fill"></i> Catálogo
                    </a>
                    <a asp-controller="Tienda" asp-action="Carrito" class="cliente-mobile-item @(activeNav == "carrito" ? "active" : "")">
                        <i class="bi bi-cart3"></i> Carrito
                        <span id="mobileNavCartBadge" class="cliente-cart-badge ms-auto @(carritoCount > 0 ? "visible" : "")">@carritoCount</span>
                    </a>
                    <a asp-controller="Tienda" asp-action="MisPedidos" class="cliente-mobile-item @(activeNav == "pedidos" ? "active" : "")">
                        <i class="bi bi-bag-check-fill"></i> Mis Pedidos
                    </a>
                    <a asp-controller="Home" asp-action="Trabaja" class="cliente-mobile-item @(activeNav == "trabaja" ? "active" : "")">
                        <i class="bi bi-people-fill"></i> Crezcamos juntos
                    </a>
                    <a asp-controller="Account" asp-action="Perfil" class="cliente-mobile-item @(activeNav == "perfil" ? "active" : "")">
                        <i class="bi bi-person-circle"></i> Mi Perfil

                    </a>
                }
                <hr class="my-2" />
                <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="cliente-mobile-item text-danger border-0 bg-transparent w-100 text-start">
                        <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                    </button>
                </form>
            </div>
        </div>
    </header>

    <!-- Toast de Notificaciones Flotante Asíncrono (Micro-animado) -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1200; margin-top: 70px;">
        <div id="liveToast" class="toast align-items-center text-white bg-success border-0 shadow-lg rounded-4" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex p-2">
                <div class="toast-body d-flex align-items-center gap-2 fw-medium" id="toastMessage">
                    <i class="bi bi-check2-circle fs-5"></i>
                    <span>¡Producto añadido al carrito!</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    </div>

    <!-- Contenido Principal a Ancho Completo -->
    <main role="main" class="cliente-main-content">
        @RenderBody()
    </main>

    <!-- Footer Moderno -->
    <footer class="cliente-footer">
        <div class="container-fluid px-3 px-lg-5 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 py-3">
            <div class="text-muted small">
                &copy; @DateTime.Now.Year <strong>FarmaVida</strong>. Tu farmacia online de confianza.
            </div>
            <div class="d-flex align-items-center gap-3 text-muted small">
                <span><i class="bi bi-shield-check text-success"></i> Compra 100% Segura</span>
                <span>•</span>
                <span><i class="bi bi-truck text-primary"></i> Envíos a Domicilio</span>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Alternar menú móvil
        (function () {
            const btn = document.getElementById('mobileMenuBtn');
            const drawer = document.getElementById('mobileDrawer');
            if (btn && drawer) {
                btn.addEventListener('click', () => {
                    drawer.classList.toggle('open');
                });
            }
        })();

        // Función global para actualizar contador de carrito con micro-animación bounce
        function actualizarBadgeCarrito(nuevoTotal) {
            const badges = [document.getElementById('navCartBadge'), document.getElementById('mobileNavCartBadge')];
            badges.forEach(b => {
                if (!b) return;
                b.innerText = nuevoTotal;
                if (nuevoTotal > 0) {
                    b.classList.add('visible');
                    b.classList.remove('bounce');
                    void b.offsetWidth; // trigger reflow
                    b.classList.add('bounce');
                } else {
                    b.classList.remove('visible');
                }
            });
        }

        // Función global para mostrar Toast flotante sin saltos
        function mostrarToast(mensaje, tipo = 'success') {
            const toastEl = document.getElementById('liveToast');
            const toastMsg = document.getElementById('toastMessage');
            if (!toastEl || !toastMsg) return;

            toastEl.className = `toast align-items-center text-white bg-${tipo} border-0 shadow-lg rounded-4`;
            toastMsg.innerHTML = `<i class="bi bi-${tipo === 'success' ? 'check2-circle' : 'exclamation-circle'} fs-5"></i> <span>${mensaje}</span>`;
            
            const toast = bootstrap.Toast.getOrCreateInstance(toastEl, { delay: 3500 });
            toast.show();
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
