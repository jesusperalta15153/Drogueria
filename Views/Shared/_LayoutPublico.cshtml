<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="FarmaVida — Tu aliado de salud. Productos farmaceuticos, medicamentos y mas." />
    <title>@ViewData["Title"] - FarmaVida</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logodrogueria.svg" />

<script>
    // Carga inmediata de tema para evitar parpadeo y mantener preferencia al recargar
    (function () {
        const savedTheme = localStorage.getItem('app_theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
    })();
</script>


<!-- Animación suave para la navegación -->
<script>
    document.addEventListener('DOMContentLoaded', function () {

        document.addEventListener('click', function (e) {

            const enlace = e.target.closest('a[href^="#"]');

            if (!enlace) {
                return;
            }

            const destinoId = enlace.getAttribute('href');

            // Ignorar enlaces que solamente tienen #
            if (!destinoId || destinoId === '#') {
                return;
            }

            const destino = document.querySelector(destinoId);

            if (!destino) {
                return;
            }

            e.preventDefault();

            const inicio = window.scrollY;
            const destinoY = destino.getBoundingClientRect().top + window.scrollY;

            const distancia = destinoY - inicio;

            // Más distancia = un poco más de duración
            const duracion = Math.min(
                1200,
                Math.max(600, Math.abs(distancia) * 0.8)
            );

            let tiempoInicio = null;

            function animar(tiempoActual) {

                if (tiempoInicio === null) {
                    tiempoInicio = tiempoActual;
                }

                const progreso = Math.min(
                    (tiempoActual - tiempoInicio) / duracion,
                    1
                );

                // Suavizado: acelera al principio y desacelera al final
                const suavizado =
                    progreso < 0.5
                        ? 2 * progreso * progreso
                        : 1 - Math.pow(-2 * progreso + 2, 2) / 2;

                window.scrollTo(
                    0,
                    inicio + distancia * suavizado
                );

                if (progreso < 1) {
                    requestAnimationFrame(animar);
                }
            }

            requestAnimationFrame(animar);
        });

    });
</script>



