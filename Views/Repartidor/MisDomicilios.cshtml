@model IEnumerable<Drogueria.Models.Pedido>
@{
    ViewData["Title"] = "Mis Domicilios";
    ViewData["ActiveNav"] = "misdomicilios";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    var lista = Model ?? Enumerable.Empty<Drogueria.Models.Pedido>();
    var totalActivos = lista.Count();
    var enCamino = lista.Count(p => p.Estado == "En camino");
    var pendientes = lista.Count(p => p.Estado == "Pendiente" || p.Estado == "Confirmado");
    var estaEnLinea = ViewBag.EstaEnLinea != null ? (bool)ViewBag.EstaEnLinea : true;
    var nombreRepartidor = ViewBag.RepartidorNombre as string ?? "Repartidor";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
.domicilios-wrap { padding: 28px 24px; max-width: 1200px; margin: 0 auto; }
@@media (max-width: 576px) { .domicilios-wrap { padding: 16px 12px; } }

/* Tarjeta de estado de trabajo (En Línea / En Descanso) */
.disponibilidad-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 20px 24px;
    box-shadow: 0 4px 20px rgba(0,0,0,.05);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    transition: all .3s ease;
}
.disponibilidad-card.en-linea {
    border-left: 5px solid #10b981;
    background: linear-gradient(to right, rgba(16,185,129,.06), var(--bg-card) 40%);
}
.disponibilidad-card.en-descanso {
    border-left: 5px solid #f59e0b;
    background: linear-gradient(to right, rgba(245,158,11,.06), var(--bg-card) 40%);
}
[data-bs-theme="dark"] .disponibilidad-card { box-shadow: 0 4px 24px rgba(0,0,0,.4); }

.status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border-radius: 99px;
    font-size: 13px;
    font-weight: 700;
}
.status-pill.online {
    background: rgba(16,185,129,.15);
    color: #10b981;
    border: 1px solid rgba(16,185,129,.35);
}
.status-pill.resting {
    background: rgba(245,158,11,.15);
    color: #d97706;
    border: 1px solid rgba(245,158,11,.35);
}
[data-bs-theme="dark"] .status-pill.online { color: #34d399; }
[data-bs-theme="dark"] .status-pill.resting { color: #fbbf24; }

.status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
}
.status-dot.online {
    background-color: #10b981;
    box-shadow: 0 0 10px #10b981;
    animation: pulse 1.8s infinite;
}
.status-dot.resting {
    background-color: #f59e0b;
}

.domicilio-card { background: var(--bg-card); border-radius: 18px; border: 1px solid var(--border); box-shadow: 0 2px 12px rgba(0,0,0,.06); overflow: hidden; margin-bottom: 24px; }
.domicilio-card.en-camino { border: 2px solid #f59e0b; box-shadow: 0 2px 20px rgba(245,158,11,.18); }
[data-bs-theme="dark"] .domicilio-card { box-shadow: 0 2px 16px rgba(0,0,0,.4); }
[data-bs-theme="dark"] .domicilio-card.en-camino { box-shadow: 0 2px 24px rgba(245,158,11,.28); }

.domicilio-card-header { padding: 20px 24px 16px; border-bottom: 1px solid var(--border); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
.domicilio-card-body { padding: 20px 24px; }

.domicilio-info-map { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
@@media (max-width: 768px) { .domicilio-info-map { grid-template-columns: 1fr; } .domicilio-card-header { flex-direction: column; align-items: flex-start; } }

.domicilio-map-box { border-radius: 14px; overflow: hidden; border: 1px solid var(--border); min-height: 280px; background: var(--bg-muted); display: flex; flex-direction: column; }
.domicilio-map-box .map-label { padding: 10px 14px; font-size: 12px; font-weight: 600; color: var(--t-muted); background: var(--bg-muted); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; }
.domicilio-map-placeholder { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 36px 16px; color: var(--t-muted); text-align: center; min-height: 220px; }

/* Panel de Información de Ruta y ETA */
.ruta-info-card { background: var(--bg-card); border-bottom: 1px solid var(--border); padding: 12px 16px; transition: all .3s ease; }
.ruta-stats-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 10px; }
@@media (max-width: 500px) { .ruta-stats-row { grid-template-columns: 1fr; gap: 6px; } }

.ruta-stat-box { display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 10px; background: var(--bg-muted); border: 1px solid var(--border); }
.ruta-stat-box.orange .ruta-stat-icon { background: rgba(245,158,11,.15); color: #f59e0b; }
.ruta-stat-box.primary .ruta-stat-icon { background: rgba(59,130,246,.15); color: #3b82f6; }
.ruta-stat-box.green .ruta-stat-icon { background: rgba(16,185,129,.15); color: #10b981; }

.ruta-stat-icon { width: 34px; height: 34px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
.ruta-stat-value { font-size: 15px; font-weight: 700; color: var(--t-base); line-height: 1.2; }
.ruta-stat-label { font-size: 10px; color: var(--t-muted); text-transform: uppercase; font-weight: 600; letter-spacing: .4px; }

.ruta-nav-toolbar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.ruta-nav-toolbar .btn { font-size: 12px; font-weight: 600; padding: 5px 12px; border-radius: 99px; }

.info-row { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 12px; font-size: 14px; }
.info-row > i { color: var(--primary); margin-top: 2px; flex-shrink: 0; }
.info-row .label { font-weight: 600; color: var(--t-muted); font-size: 11px; text-transform: uppercase; letter-spacing: .4px; margin-bottom: 2px; }
.info-row .value { color: var(--t-base); font-weight: 500; }

.product-list { list-style: none; padding: 0; margin: 0; }
.product-list li { display: flex; justify-content: space-between; align-items: center; padding: 7px 0; border-bottom: 1px dashed var(--border); font-size: 13px; color: var(--t-base); }
.product-list li:last-child { border-bottom: none; }
.domicilio-card-body .border-top { border-color: var(--border) !important; }

.estado-badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 12px; border-radius: 99px; font-size: 12px; font-weight: 700; }
.estado-encamino  { background: rgba(245,158,11,.15); color: #d97706; border: 1px solid rgba(245,158,11,.3); }
.estado-entregado { background: rgba(16,185,129,.15);  color: #10b981; border: 1px solid rgba(16,185,129,.3); }
.estado-pendiente { background: rgba(124,58,237,.15);  color: var(--primary); border: 1px solid rgba(124,58,237,.3); }
[data-bs-theme="dark"] .estado-encamino  { background: rgba(245,158,11,.22);  color: #fbbf24; border-color: rgba(245,158,11,.4); }
[data-bs-theme="dark"] .estado-entregado { background: rgba(16,185,129,.22);   color: #34d399; border-color: rgba(16,185,129,.4); }
[data-bs-theme="dark"] .estado-pendiente { background: rgba(139,92,246,.22);   color: #a78bfa; border-color: rgba(139,92,246,.4); }

.gps-badge { font-size: 11px; padding: 3px 10px; border-radius: 99px; font-weight: 600; font-family: monospace; display: inline-flex; align-items: center; }

.map-legend { background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; font-size: 11px; display: flex; gap: 14px; flex-wrap: wrap; color: var(--t-muted); margin: 6px 8px 8px; }
.map-legend span { display: inline-flex; align-items: center; gap: 6px; }

.animate-pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
@@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .45; } }
</style>

<div class="domicilios-wrap">

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Toast flotante dinámico para notificaciones inmediatas -->
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1090;">
    <div id="disponibilidadToast" class="toast align-items-center text-white border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 14px;">
        <div class="d-flex">
            <div class="toast-body d-flex align-items-center gap-2 fw-semibold" id="disponibilidadToastBody">
                <i class="bi bi-info-circle-fill fs-5"></i>
                <span id="disponibilidadToastMsg">Estado actualizado</span>
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

<div class="mb-4">
    <h1 class="fw-bold mb-1" style="font-size: clamp(1.4rem, 4vw, 2rem);">Mis Domicilios</h1>
    <p class="text-muted mb-0" style="font-size:14px;">Pedidos activos asignados. Visualiza la ruta óptima al cliente y gestiona tus entregas.</p>
</div>

<!-- PANEL DE CONTROL DE DISPONIBILIDAD (EN LÍNEA / DESCANSO) -->
<div class="disponibilidad-card @(estaEnLinea ? "en-linea" : "en-descanso")" id="cardDisponibilidad">
    <div class="d-flex align-items-center gap-3">
        <div class="status-indicator-icon p-3 rounded-circle d-flex align-items-center justify-content-center shadow-sm"
             id="statusIconBox"
             style="width: 54px; height: 54px; background: @(estaEnLinea ? "rgba(16,185,129,.15)" : "rgba(245,158,11,.15)"); color: @(estaEnLinea ? "#10b981" : "#f59e0b");">
            <i class="bi @(estaEnLinea ? "bi-broadcast" : "bi-cup-hot-fill") fs-4"></i>
        </div>
        <div>
            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <span class="status-pill @(estaEnLinea ? "online" : "resting")" id="statusBadge">
                    <span class="status-dot @(estaEnLinea ? "online" : "resting")" id="statusDot"></span>
                    <span id="statusText">@(estaEnLinea ? "EN LÍNEA · Activo" : "EN DESCANSO · Inactivo")</span>
                </span>
                <span class="badge bg-light text-muted border px-2 py-1" style="font-size: 11px;">Disponibilidad</span>
            </div>
            <p class="text-muted mb-0" id="statusDesc" style="font-size: 13px; max-width: 650px;">
                @(estaEnLinea 
                    ? "Estás activo y disponible. El sistema te asignará nuevos pedidos automáticamente por cercanía." 
                    : $"Estás en modo descanso. No se te asignarán nuevos pedidos. Puedes continuar y entregar tus {totalActivos} pedidos asignados normalmente.")
            </p>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <form id="formDisponibilidad" asp-controller="Repartidor" asp-action="ToggleDisponibilidad" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="enLinea" id="inputEnLinea" value="@((!estaEnLinea).ToString().ToLowerInvariant())" />
            <button type="button" class="btn @(estaEnLinea ? "btn-outline-warning" : "btn-success") rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm"
                    id="btnToggleDisponibilidad"
                    onclick="cambiarEstadoDisponibilidad()">
                <i class="bi @(estaEnLinea ? "bi-pause-circle-fill" : "bi-play-circle-fill")"></i>
                <span id="btnToggleText">@(estaEnLinea ? "Pausar y Descansar" : "Conectarme (En Línea)")</span>
            </button>
        </form>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4"><div class="dash-kpi-card purple p-3"><span class="dash-kpi-label">Activos</span><div class="dash-kpi-val">@totalActivos</div></div></div>
    <div class="col-6 col-md-4"><div class="dash-kpi-card orange p-3"><span class="dash-kpi-label">Pendientes</span><div class="dash-kpi-val">@pendientes</div></div></div>
    <div class="col-12 col-md-4"><div class="dash-kpi-card teal p-3"><span class="dash-kpi-label">En Camino</span><div class="dash-kpi-val">@enCamino</div></div></div>
</div>

@if (!lista.Any())
{
    <div class="domicilio-card text-center p-5">
        <i class="bi bi-truck fs-1 text-muted opacity-50 d-block mb-3"></i>
        <h5 class="fw-bold">No tienes domicilios activos</h5>
        <p class="text-muted small mb-0">Cuando un empleado te asigne un pedido pendiente, aparecerá aquí.</p>
        <a asp-controller="Repartidor" asp-action="Historial" class="btn btn-outline-secondary rounded-pill px-4 mt-3 fw-semibold" style="font-size:13px;">
            <i class="bi bi-clock-history me-1"></i> Ver Historial de Entregas
        </a>
    </div>
}
else
{
    @foreach (var p in lista)
    {
        var shortId = p.Id.ToString().Substring(0, 8).ToUpper();
        var clientName = p.Usuario != null ? $"{p.Usuario.Nombre} {p.Usuario.Apellido}".Trim() : "Cliente";
        var isEnCamino = p.Estado == "En camino";
        var isEntregado = p.Estado == "Entregado";

        // Segmentos de dirección
        var dirRaw = p.DireccionEntrega ?? "";
        var dirPartes = dirRaw.Split('|');
        var dirNombre = dirPartes.Length > 0 ? dirPartes[0].Trim() : "";
        var dirCalle  = dirPartes.Length > 1 ? dirPartes[1].Trim() : dirRaw;
        var dirTel    = dirPartes.Length > 2 ? dirPartes[2].Trim() : "";
        if (dirTel.Contains("| GEO:")) dirTel = dirTel.Split("| GEO:")[0].Trim();

        var geoQueryP = "";
        var geoSegP = dirPartes.FirstOrDefault(s => s.TrimStart().StartsWith("GEO:"));
        if (geoSegP != null)
            geoQueryP = geoSegP.Replace("GEO:", "").Trim();
        else
            geoQueryP = dirCalle;

        <div class="domicilio-card @(isEnCamino ? "en-camino" : "")">
            <div class="domicilio-card-header">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <code class="fw-bold fs-6 text-primary">#@shortId</code>
                    <span class="estado-badge @(isEnCamino ? "estado-encamino" : isEntregado ? "estado-entregado" : "estado-pendiente")">
                        <i class="bi @(isEnCamino ? "bi-truck" : isEntregado ? "bi-check-all" : "bi-clock")"></i> @p.Estado
                    </span>
                    @if (isEnCamino)
                    {
                        <span class="gps-badge bg-danger text-white" id="gpsStatus-@p.Id"><i class="bi bi-broadcast me-1"></i>Conectando GPS...</span>
                    }
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    @if (!isEntregado && !isEnCamino)
                    {
                        var tieneOtroEnCamino = lista.Any(o => o.Estado == "En camino");
                        if (tieneOtroEnCamino)
                        {
                            <button type="button" class="btn btn-secondary rounded-pill px-4 fw-semibold d-inline-flex align-items-center gap-2 opacity-75"
                                    title="Ya tienes una entrega en camino. Termina y entrega el pedido activo antes de iniciar otro."
                                    onclick="alert('Ya tienes una entrega en curso. Debes finalizar y entregar ese pedido antes de iniciar uno nuevo.');">
                                <i class="bi bi-lock-fill"></i> Iniciar Entrega
                            </button>
                        }
                        else
                        {
                            <form asp-controller="Repartidor" asp-action="CambiarEstado" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@p.Id" />
                                <input type="hidden" name="estado" value="En camino" />
                                <button type="submit" class="btn btn-warning rounded-pill px-4 fw-semibold d-inline-flex align-items-center gap-2">
                                    <i class="bi bi-play-circle-fill"></i> Iniciar Entrega
                                </button>
                            </form>
                        }
                    }
                    @if (isEnCamino)
                    {
                        <button type="button"
                                class="btn btn-success rounded-pill px-4 fw-semibold d-inline-flex align-items-center gap-2"
                                onclick="abrirConfirmarEntrega('@p.Id', '@Html.Raw(clientName.Replace("'", "\'"))')">
                            <i class="bi bi-check-circle-fill"></i> Marcar Entregado
                        </button>
                        <button type="button"
                                class="btn btn-primary rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-2"
                                onclick="abrirChatRepartidor('@p.Id', '@Html.Raw(clientName.Replace("'", "\'"))')">
                            <i class="bi bi-chat-dots-fill"></i> Chatear
                        </button>
                    }
                </div>
            </div>
            <div class="domicilio-card-body">
                <div class="domicilio-info-map">
                    <!-- Columna izquierda: Datos del pedido y del cliente -->
                    <div>
                        <div class="info-row">
                            <i class="bi bi-person-fill"></i>
                            <div>
                                <div class="label">Cliente</div>
                                <div class="value">@clientName</div>
                                <div class="text-muted" style="font-size:12px;">@(p.Usuario?.Email ?? "")</div>
                            </div>
                        </div>

                        <div class="info-row">
                            <i class="bi bi-geo-alt-fill" style="color:#ef4444;"></i>
                            <div>
                                <div class="label">Dirección de Entrega</div>
                                @if (string.IsNullOrEmpty(dirRaw))
                                {
                                    <div class="value text-muted fst-italic">Sin dirección registrada</div>
                                }
                                else
                                {
                                    <div class="value fw-bold">@dirNombre</div>
                                    <div class="text-muted" style="font-size:12px;">@dirCalle</div>
                                    @if (!string.IsNullOrEmpty(dirTel))
                                    {
                                        <div class="text-muted" style="font-size:12px;"><i class="bi bi-telephone me-1"></i>@dirTel.Replace("Tel:","").Trim()</div>
                                    }
                                }
                            </div>
                        </div>

                        <div class="info-row">
                            <i class="bi bi-calendar3"></i>
                            <div>
                                <div class="label">Fecha</div>
                                <div class="value">@p.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                            </div>
                        </div>

                        <div class="info-row">
                            <i class="bi bi-bag-fill"></i>
                            <div>
                                <div class="label">Productos (@p.Detalles.Count)</div>
                                <ul class="product-list mt-1">
                                    @foreach (var d in p.Detalles)
                                    {
                                        <li>
                                            <span>@(d.Producto?.Nombre ?? "Producto") <span class="text-muted">x @d.Cantidad</span></span>
                                            <span class="fw-bold text-primary">$@d.Subtotal.ToString("N2")</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>

                        @{
                            var calc = Drogueria.Controllers.RepartidorGananciasHelper.Calcular(p);
                        }
                        <div class="p-3 rounded-3 mt-3 mb-2" style="background: rgba(16,185,129,.07); border: 1px solid rgba(16,185,129,.25);">
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                <span class="fw-bold text-success d-inline-flex align-items-center gap-2" style="font-size:13.5px;">
                                    <i class="bi bi-wallet2 fs-5"></i> Tu Ganancia estimada:
                                </span>
                                <span class="fs-4 fw-bold text-success">$@calc.GananciaTotal.ToString("N2")</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 pt-2 border-top" style="border-color: rgba(16,185,129,.2) !important; font-size:11.5px;">
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-truck text-primary me-1"></i> Tarifa de envío: <strong>$@calc.TarifaEnvio.ToString("N2")</strong>
                                </span>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-heart-fill text-danger me-1"></i> Propina: <strong>$@calc.Propina.ToString("N2")</strong>
                                </span>
                                @if (calc.SuperaLimite)
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle fw-bold" title="12% de comisión sobre la compra de $@calc.SubtotalProductos.ToString("N2") por superar el límite de $45.000">
                                        <i class="bi bi-award-fill text-warning me-1"></i> Bono 12% (> $45.000): <strong>+$@calc.Comision12.ToString("N2")</strong>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">
                                        <i class="bi bi-dash-circle me-1"></i> Bono 12%: $0 (&lt; $45.000)
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-2 text-muted" style="font-size:12px;">
                            <span>Total a cobrar/facturado al cliente:</span>
                            <span class="fw-semibold text-secondary">$@p.Total.ToString("N2")</span>
                        </div>
                    </div>

                    <!-- Columna derecha: MAPA, RUTA Y TIEMPO DE LLEGADA -->
                    <div class="domicilio-map-box" id="mapBox-@p.Id">
                        <div class="map-label">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-map-fill text-primary"></i>
                                @if (isEnCamino) { <span class="fw-bold">Ruta en Vivo al Destino</span> }
                                else if (isEntregado && p.LatitudRepartidor.HasValue) { <span>Última Ubicación Registrada</span> }
                                else { <span>Mapa de Entrega</span> }
                            </div>
                            <div id="routeStatusBadge-@p.Id">
                                @if (isEnCamino)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-broadcast me-1"></i>GPS Activo</span>
                                }
                            </div>
                        </div>

                        <!-- Panel de Información de Ruta y Tiempo de Llegada (ETA) -->
                        <div class="ruta-info-card" id="rutaInfo-@p.Id" style="@(isEnCamino ? "" : "display:none;")">
                            <div class="ruta-stats-row">
                                <div class="ruta-stat-box orange">
                                    <div class="ruta-stat-icon"><i class="bi bi-stopwatch-fill"></i></div>
                                    <div>
                                        <div class="ruta-stat-value" id="etaTime-@p.Id">Calculando...</div>
                                        <div class="ruta-stat-label">Tiempo Estimado</div>
                                    </div>
                                </div>
                                <div class="ruta-stat-box primary">
                                    <div class="ruta-stat-icon"><i class="bi bi-signpost-split-fill"></i></div>
                                    <div>
                                        <div class="ruta-stat-value" id="etaDist-@p.Id">-- km</div>
                                        <div class="ruta-stat-label">Distancia</div>
                                    </div>
                                </div>
                                <div class="ruta-stat-box green">
                                    <div class="ruta-stat-icon"><i class="bi bi-clock-history"></i></div>
                                    <div>
                                        <div class="ruta-stat-value" id="etaHora-@p.Id">--:--</div>
                                        <div class="ruta-stat-label">Llegada Aprox.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="ruta-nav-toolbar">
                                <button type="button" class="btn btn-outline-primary btn-sm" onclick="centrarRuta('@p.Id')">
                                    <i class="bi bi-arrows-fullscreen me-1"></i> Ver ruta completa
                                </button>
                                <a id="btnGmaps-@p.Id" href="#" target="_blank" rel="noopener noreferrer" class="btn btn-success btn-sm disabled" style="text-decoration:none;">
                                    <i class="bi bi-google me-1"></i> Google Maps
                                </a>
                                @if (!string.IsNullOrEmpty(dirTel))
                                {
                                    <a href="tel:@dirTel.Replace("Tel:","").Trim()" class="btn btn-outline-secondary btn-sm ms-auto" style="text-decoration:none;">
                                        <i class="bi bi-telephone-fill me-1"></i> Llamar
                                    </a>
                                }
                            </div>
                        </div>

                        @if (isEnCamino || (isEntregado && p.LatitudRepartidor.HasValue))
                        {
                            <div id="map-@p.Id" data-direccion="@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(p.DireccionEntrega ?? ""))" style="height:320px;width:100%;"></div>
                            @if (isEnCamino && !string.IsNullOrEmpty(p.DireccionEntrega))
                            {
                                <div class="map-legend">
                                    <span><span style="display:inline-block;width:11px;height:11px;border-radius:50%;background:#f59e0b;border:1px solid rgba(0,0,0,.2);"></span> Tu ubicación</span>
                                    <span><span style="display:inline-block;width:11px;height:11px;border-radius:50%;background:#ef4444;border:1px solid rgba(0,0,0,.2);"></span> Destino del cliente</span>
                                    <span><span style="display:inline-block;width:18px;height:4px;border-radius:2px;background:#2563eb;"></span> Ruta trazada</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div id="placeholder-@p.Id" class="domicilio-map-placeholder">
                                <i class="bi bi-map" style="font-size:2.5rem;opacity:.25;margin-bottom:10px;"></i>
                                <span style="font-size:13px;font-weight:600;">El mapa se activa al iniciar la entrega</span>
                                <span style="font-size:11px;margin-top:4px;">Presiona Iniciar Entrega para ver la ruta óptima y tiempo aproximado</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill mt-3 px-3"
                                        onclick="previsualizarRutaPedido('@p.Id', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(geoQueryP))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(dirNombre))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(dirCalle))')">
                                    <i class="bi bi-eye me-1"></i> Ver vista previa de la ruta
                                </button>
                            </div>
                            <div id="map-@p.Id" data-direccion="@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(p.DireccionEntrega ?? ""))" style="height:320px;width:100%;display:none;"></div>
                            <div id="legend-@p.Id" class="map-legend" style="display:none;">
                                <span><span style="display:inline-block;width:11px;height:11px;border-radius:50%;background:#f59e0b;border:1px solid rgba(0,0,0,.2);"></span> Tu ubicación</span>
                                <span><span style="display:inline-block;width:11px;height:11px;border-radius:50%;background:#ef4444;border:1px solid rgba(0,0,0,.2);"></span> Destino del cliente</span>
                                <span><span style="display:inline-block;width:18px;height:4px;border-radius:2px;background:#2563eb;"></span> Ruta trazada</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
</div>

<!-- Modal confirmar entrega -->
<div class="modal fade" id="modalConfirmarEntrega" tabindex="-1" aria-labelledby="modalConfirmarEntregaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px; border:1px solid var(--border); background:var(--bg-card);">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalConfirmarEntregaLabel">
                    <i class="bi bi-shield-check text-success me-2"></i>Confirmar Entrega de Pedido
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-muted mb-2" style="font-size:14px;">
                    Solicita al cliente <strong id="confirmarClienteNombre">—</strong> su <strong>código de confirmación de 6 dígitos</strong> para validar la entrega:
                </p>
                <div class="my-3">
                    <input type="text" id="confirmarCodigoInput" name="codigoConfirmacion" maxlength="6"
