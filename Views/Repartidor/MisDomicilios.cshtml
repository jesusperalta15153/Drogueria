@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
// Almacena controladores de mapas para cada pedido
const orderTrackers = {};

// Instancia global de SignalR
const connection = new signalR.HubConnectionBuilder()
    .withUrl("/hubs/ubicacion")
    .withAutomaticReconnect()
    .build();

document.addEventListener("DOMContentLoaded", function () {
    connection.start().catch(err => console.error("SignalR:", err));

    @foreach (var p in lista.Where(p => p.Estado == "En camino"))
    {
        var partesDirP = (p.DireccionEntrega ?? "").Split('|');
        var geoQueryP = "";
        var popupNombreP = partesDirP.Length > 0 ? partesDirP[0].Trim() : "Cliente";
        var popupCalleP  = partesDirP.Length > 1 ? partesDirP[1].Trim() : (p.DireccionEntrega ?? "");
        var geoSegP = partesDirP.FirstOrDefault(s => s.TrimStart().StartsWith("GEO:"));
        if (geoSegP != null)
            geoQueryP = geoSegP.Replace("GEO:", "").Trim();
        else
            geoQueryP = popupCalleP;

        <text>
        inicializarMapaRuta(
            "@p.Id",
            @(p.LatitudRepartidor.HasValue ? p.LatitudRepartidor.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "4.60971"),
            @(p.LongitudRepartidor.HasValue ? p.LongitudRepartidor.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "-74.08175"),
            "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(geoQueryP))",
            "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(popupNombreP))",
            "@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(popupCalleP))",
            true, // esEnCamino: activa GPS continuo
            connection
        );
        </text>
    }

    @foreach (var p in lista.Where(p => p.Estado == "Entregado" && p.LatitudRepartidor.HasValue))
    {
        <text>
        (function(){
            const map = L.map("map-@p.Id").setView([@(p.LatitudRepartidor!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)),@(p.LongitudRepartidor!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))],15);
            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{attribution:"&copy; OpenStreetMap"}).addTo(map);
            const iconEntregado = L.divIcon({
                className: '',
                html: '<div style="background:#10b981;color:#fff;border-radius:50%;width:34px;height:34px;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(0,0,0,.3);border:2px solid #fff;"><i class=\"bi bi-check-lg fs-5\"></i></div>',
                iconSize: [34,34],
                iconAnchor: [17,17]
            });
            L.marker([@(p.LatitudRepartidor!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)),@(p.LongitudRepartidor!.Value.ToString(System.Globalization.CultureInfo.InvariantCulture))], { icon: iconEntregado }).addTo(map).bindPopup("<b>Lugar de Entrega Finalizada</b>").openPopup();
        })();
        </text>
    }
});

/**
 * Inicializa el mapa, marcador de repartidor, destino y cálculo de ruta con tiempo estimado.
 */
function inicializarMapaRuta(pid, lat0, lng0, geoQuery, destNombre, destCalle, activarGpsVivo, connection) {
    if (orderTrackers[pid] && orderTrackers[pid].map) {
        return;
    }

    const mapEl = document.getElementById("map-" + pid);
    if (!mapEl) return;
    mapEl.style.display = "block";

    const placeholderEl = document.getElementById("placeholder-" + pid);
    if (placeholderEl) placeholderEl.style.display = "none";
    const legendEl = document.getElementById("legend-" + pid);
    if (legendEl) legendEl.style.display = "flex";

    const map = L.map("map-" + pid).setView([lat0, lng0], 15);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: "&copy; OpenStreetMap" }).addTo(map);

    const iconRep = L.divIcon({
        className: "",
        html: '<div style="background:#f59e0b;color:#fff;border-radius:50%;width:38px;height:38px;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(245,158,11,.4);border:2px solid #fff;"><i class=\"bi bi-truck fs-5\"></i></div>',
        iconSize: [38, 38],
        iconAnchor: [19, 19]
    });
    const markerRep = L.marker([lat0, lng0], { icon: iconRep }).addTo(map).bindPopup("<b>Tu ubicación actual (Repartidor)</b>");

    orderTrackers[pid] = {
        map: map,
        markerRep: markerRep,
        markerDest: null,
        routeLayer: null,
        repLat: lat0,
        repLng: lng0,
        destLat: null,
        destLng: null,
        destNombre: destNombre,
        destCalle: destCalle,
        lastFetchTime: 0,
        hasFittedBounds: false
    };

    // Geocodificar destino
    if (geoQuery && geoQuery.trim() !== '') {
        fetch('/Direccion/Geocodificar?' + new URLSearchParams({ direccion: geoQuery, ciudad: '' }), {
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                const iconDest = L.divIcon({
                    className: '',
                    html: '<div style="background:#ef4444;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 10px rgba(239,68,68,.4);border:2px solid #fff;"><i class=\"bi bi-house-fill\" style=\"font-size:17px;\"></i></div>',
                    iconSize: [36, 36],
                    iconAnchor: [18, 18]
                });

                const markerDest = L.marker([data.lat, data.lon], { icon: iconDest })
                    .addTo(map)
                    .bindPopup(`<b>${destNombre || 'Cliente'}</b><br>${destCalle || ''}`);

                orderTrackers[pid].markerDest = markerDest;
                orderTrackers[pid].destLat = data.lat;
                orderTrackers[pid].destLng = data.lon;

                // Trazar ruta inmediata
                calcularYTrazarRuta(pid, connection);
            }
        })
        .catch(err => console.error("Error geocodificando destino:", err));
    }

    // Activar GPS en vivo si está en camino
    if (activarGpsVivo && "geolocation" in navigator) {
        const statusEl = document.getElementById("gpsStatus-" + pid);

        navigator.geolocation.watchPosition(
            function (pos) {
                const lat = pos.coords.latitude;
                const lng = pos.coords.longitude;
                orderTrackers[pid].repLat = lat;
                orderTrackers[pid].repLng = lng;

                markerRep.setLatLng([lat, lng]);

                if (statusEl) {
                    statusEl.innerHTML = `<i class="bi bi-broadcast me-1"></i>GPS Activo: ${lat.toFixed(4)}, ${lng.toFixed(4)}`;
                    statusEl.className = "gps-badge bg-success text-white";
                }

                // Guardar en base de datos
                const fd = new FormData();
                fd.append("id", pid);
                fd.append("lat", lat);
                fd.append("lng", lng);
                fetch("/Repartidor/ActualizarUbicacion", { method: "POST", body: fd }).catch(() => {});

                // Recalcular ruta si han pasado al menos 15 segundos
                const now = Date.now();
                if (now - orderTrackers[pid].lastFetchTime > 15000) {
                    calcularYTrazarRuta(pid, connection);
                }
            },
            function (err) {
                if (statusEl) {
                    statusEl.textContent = "Error GPS: " + err.message;
                    statusEl.className = "gps-badge bg-danger text-white";
                }
            },
            { enableHighAccuracy: true, timeout: 15000, maximumAge: 0 }
        );
    }
}

/**
 * Consulta la ruta vial y tiempo de llegada estimado a través del controlador /Direccion/CalcularRuta
 */
async function calcularYTrazarRuta(pid, connection) {
    const trk = orderTrackers[pid];
    if (!trk || !trk.map || trk.repLat == null || trk.repLng == null || trk.destLat == null || trk.destLng == null) {
        return;
    }

    trk.lastFetchTime = Date.now();

    const etaTimeEl = document.getElementById("etaTime-" + pid);
    const etaDistEl = document.getElementById("etaDist-" + pid);
    const etaHoraEl = document.getElementById("etaHora-" + pid);
    const rutaInfoEl = document.getElementById("rutaInfo-" + pid);
    const btnGmaps = document.getElementById("btnGmaps-" + pid);

    try {
        const url = `/Direccion/CalcularRuta?origenLat=${trk.repLat}&origenLng=${trk.repLng}&destinoLat=${trk.destLat}&destinoLng=${trk.destLng}`;
        const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        const data = await res.json();

        if (data.success) {
            // Actualizar tarjetas de ETA
            if (etaTimeEl) etaTimeEl.textContent = data.tiempoTexto;
            if (etaDistEl) etaDistEl.textContent = data.distanciaTexto;
            if (etaHoraEl) etaHoraEl.textContent = data.horaEstimadaLlegada;
            if (rutaInfoEl) rutaInfoEl.style.display = "block";

            // Enlazar navegación externa
            if (btnGmaps) {
                btnGmaps.href = `https://www.google.com/maps/dir/?api=1&origin=${trk.repLat},${trk.repLng}&destination=${trk.destLat},${trk.destLng}&travelmode=driving`;
                btnGmaps.classList.remove("disabled");
            }

            // Dibujar la polilínea en el mapa
            if (trk.routeLayer) {
                trk.map.removeLayer(trk.routeLayer);
                trk.routeLayer = null;
            }

            if (data.geometry) {
                trk.routeLayer = L.geoJSON(data.geometry, {
                    style: {
                        color: '#2563eb',
                        weight: 6,
                        opacity: 0.88,
                        lineCap: 'round',
                        lineJoin: 'round'
                    }
                }).addTo(trk.map);

                // Auto-ajustar la vista completa de la ruta la primera vez
                if (!trk.hasFittedBounds) {
                    trk.map.fitBounds(trk.routeLayer.getBounds(), { padding: [40, 40], maxZoom: 16 });
                    trk.hasFittedBounds = true;
                }
            }

            // Notificar al cliente vía SignalR con la ruta y tiempo estimado
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                connection.invoke("EnviarUbicacionConRuta", pid, trk.repLat, trk.repLng, data.tiempoTexto, data.distanciaTexto).catch(() => {});
            }
        }
    } catch (e) {
        console.error("Error al calcular ruta:", e);
    }
}

/**
 * Centra y ajusta el mapa para ver la ruta completa del repartidor al destino.
 */
window.centrarRuta = function(pid) {
    const trk = orderTrackers[pid];
    if (!trk || !trk.map) return;
    if (trk.routeLayer) {
        trk.map.fitBounds(trk.routeLayer.getBounds(), { padding: [45, 45], maxZoom: 16 });
    } else if (trk.destLat && trk.repLat) {
        trk.map.fitBounds([[trk.repLat, trk.repLng], [trk.destLat, trk.destLng]], { padding: [45, 45], maxZoom: 16 });
    }
};

/**
 * Permite al repartidor ver la ruta y tiempo estimado de un pedido pendiente antes de iniciarlo.
 */
window.previsualizarRutaPedido = function(pid, geoQuery, destNombre, destCalle) {
    if ("geolocation" in navigator) {
        navigator.geolocation.getCurrentPosition(
            function(pos) {
                inicializarMapaRuta(pid, pos.coords.latitude, pos.coords.longitude, geoQuery, destNombre, destCalle, false, null);
            },
            function() {
                // Fallback ubicación por defecto Bogotá
                inicializarMapaRuta(pid, 4.60971, -74.08175, geoQuery, destNombre, destCalle, false, null);
            },
            { enableHighAccuracy: true, timeout: 8000 }
        );
    } else {
        inicializarMapaRuta(pid, 4.60971, -74.08175, geoQuery, destNombre, destCalle, false, null);
    }
};

function abrirConfirmarEntrega(pedidoId, clienteNombre) {
    document.getElementById('confirmarPedidoId').value = pedidoId;
    document.getElementById('confirmarClienteNombre').textContent = clienteNombre;
    const inputEl = document.getElementById('confirmarCodigoInput');
    const errEl = document.getElementById('confirmarCodigoError');
    if (inputEl) {
        inputEl.value = '';
        inputEl.classList.remove('is-invalid');
    }
    if (errEl) errEl.style.display = 'none';

    var modal = new bootstrap.Modal(document.getElementById('modalConfirmarEntrega'));
    modal.show();
}

async function confirmarEntregado() {
    const inputEl = document.getElementById('confirmarCodigoInput');
    const errEl = document.getElementById('confirmarCodigoError');
    const codigoVal = (inputEl ? inputEl.value : '').trim();

    if (!codigoVal || codigoVal.length !== 6) {
        if (inputEl) inputEl.classList.add('is-invalid');
        if (errEl) {
            errEl.textContent = 'Ingresa el código completo de 6 dígitos.';
            errEl.style.display = 'block';
        }
        return;
    }

    document.getElementById('hdnCodigoConfirmacionModal').value = codigoVal;

    const form = document.getElementById('formConfirmarEntregado');
    const modalEl = document.getElementById('modalConfirmarEntrega');
    const modal = bootstrap.Modal.getInstance(modalEl);

    const res = await window.postFormAjax(form.action, new FormData(form));
    if (res.success) {
        if (modal) modal.hide();
        window.showAppToast(res.message || 'Pedido marcado como entregado.', 'success');
        setTimeout(() => location.reload(), 600);
    } else {
        if (inputEl) inputEl.classList.add('is-invalid');
        if (errEl) {
            errEl.textContent = res.message || 'El código ingresado es incorrecto.';
            errEl.style.display = 'block';
        }
        window.showAppToast(res.message || 'Error al validar el código.', 'error');
    }
}
// ── CHAT REPARTIDOR ──────────────────────────────────────
let chatRepartidorModal = null;
let chatPedidoActivo = null;
let nombreRepartidor = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(User.Identity?.Name ?? "Repartidor"))';

function abrirChatRepartidor(pedidoId, clienteNombre) {
    chatPedidoActivo = pedidoId;
    document.getElementById('chatRepartidorClienteNombre').textContent = clienteNombre;
    
    // Limpiar caja y cargar historial permanente
    const caja = document.getElementById('chatRepartidorMensajes');
    caja.innerHTML = `
        <div class="text-center text-muted small py-4" id="chatRepartidorVacio">
            <i class="bi bi-chat-square-dots fs-3 d-block mb-2 opacity-50"></i>
            Inicia la conversación con el cliente
        </div>`;

    if (connection && connection.state === signalR.HubConnectionState.Connected) {
        connection.invoke('JoinOrderGroup', pedidoId).catch(console.error);
        connection.invoke('ObtenerHistorialChat', pedidoId)
            .then(mensajes => {
                if (mensajes && mensajes.length > 0) {
                    caja.innerHTML = '';
                    mensajes.forEach(m => {
                        const esPropio = m.remitente === nombreRepartidor;
                        agregarBurbujaRepartidor(m.remitente, m.mensaje, m.hora, esPropio);
                    });
                }
            })
            .catch(err => console.warn('Historial repartidor:', err));
    }

    chatRepartidorModal = chatRepartidorModal || new bootstrap.Modal(document.getElementById('chatRepartidorModal'));
    chatRepartidorModal.show();
    setTimeout(() => document.getElementById('chatRepartidorInput').focus(), 300);
}

function agregarBurbujaRepartidor(remitente, mensaje, hora, esPropio) {
    const vacio = document.getElementById('chatRepartidorVacio');
    if (vacio) vacio.remove();
    const caja = document.getElementById('chatRepartidorMensajes');
    const burbuja = document.createElement('div');
    burbuja.style.cssText = `display:flex;flex-direction:column;align-items:${esPropio ? 'flex-end' : 'flex-start'};`;
    const globo = document.createElement('div');
    globo.style.cssText = `max-width:78%;padding:9px 13px;border-radius:${esPropio ? '16px 16px 4px 16px' : '16px 16px 16px 4px'};
        background:${esPropio ? 'linear-gradient(135deg,#f59e0b,#d97706)' : '#fff'};
        color:${esPropio ? '#fff' : '#1e293b'};font-size:13.5px;line-height:1.45;
        box-shadow:0 2px 8px rgba(0,0,0,.08);border:${esPropio ? 'none' : '1px solid #e2e8f0'};`;
    globo.textContent = mensaje;
    const meta = document.createElement('div');
    meta.style.cssText = 'font-size:10px;color:#94a3b8;margin-top:3px;';
    meta.textContent = `${esPropio ? 'Tú' : remitente} · ${hora}`;
    burbuja.appendChild(globo);
    burbuja.appendChild(meta);
    caja.appendChild(burbuja);
    caja.scrollTop = caja.scrollHeight;
}

function enviarMensajeChatRepartidor() {
    if (!chatPedidoActivo) return;
    const input = document.getElementById('chatRepartidorInput');
    const msg = input.value.trim();
    if (!msg) return;
    connection.invoke('EnviarMensajeChat', chatPedidoActivo, nombreRepartidor, msg)
        .then(() => { input.value = ''; input.focus(); })
        .catch(err => console.error('Chat repartidor:', err));
}

connection.on('RecibirMensajeChat', function (pid, remitente, mensaje, hora) {
    const esPropio = remitente === nombreRepartidor;
    if (chatPedidoActivo === pid) {
        agregarBurbujaRepartidor(remitente, mensaje, hora, esPropio);
    } else if (!esPropio) {
        // Mensaje de otro pedido: notificar con toast si es posible
        if (window.showAppToast) window.showAppToast(`Mensaje del cliente: "${mensaje.substring(0,40)}"`, 'info');
    }
});

// Control interactivo de disponibilidad En Línea / Descanso
function cambiarEstadoDisponibilidad() {
    const btn = document.getElementById('btnToggleDisponibilidad');
    const input = document.getElementById('inputEnLinea');
    const form = document.getElementById('formDisponibilidad');
    const token = form ? (form.querySelector('input[name="__RequestVerificationToken"]')?.value || '') : '';

    if (!btn || !input) return;
    const nuevoEstado = input.value === 'true';
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Actualizando...';

    const formData = new FormData();
    formData.append('enLinea', nuevoEstado);
    if (token) formData.append('__RequestVerificationToken', token);

    fetch('/Repartidor/ToggleDisponibilidad', {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest' },
        body: formData
    })
    .then(r => r.json())
    .then(data => {
        btn.disabled = false;
        if (data.success) {
            const estaEnLinea = data.estaEnLinea;
            input.value = (!estaEnLinea).toString();

            const card = document.getElementById('cardDisponibilidad');
            const iconBox = document.getElementById('statusIconBox');
            const badge = document.getElementById('statusBadge');
            const dot = document.getElementById('statusDot');
            const text = document.getElementById('statusText');
            const desc = document.getElementById('statusDesc');

            if (estaEnLinea) {
                if (card) card.className = 'disponibilidad-card en-linea';
                if (iconBox) {
                    iconBox.style.background = 'rgba(16,185,129,.15)';
                    iconBox.style.color = '#10b981';
                    iconBox.innerHTML = '<i class="bi bi-broadcast fs-4"></i>';
                }
                if (badge) badge.className = 'status-pill online';
                if (dot) dot.className = 'status-dot online';
                if (text) text.textContent = 'EN LÍNEA · Activo';
                if (desc) desc.textContent = 'Estás activo y disponible. El sistema te asignará nuevos pedidos automáticamente por cercanía.';
                btn.className = 'btn btn-outline-warning rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm';
                btn.innerHTML = '<i class="bi bi-pause-circle-fill"></i> <span id="btnToggleText">Pausar y Descansar</span>';
            } else {
                if (card) card.className = 'disponibilidad-card en-descanso';
                if (iconBox) {
                    iconBox.style.background = 'rgba(245,158,11,.15)';
                    iconBox.style.color = '#f59e0b';
                    iconBox.innerHTML = '<i class="bi bi-cup-hot-fill fs-4"></i>';
                }
                if (badge) badge.className = 'status-pill resting';
                if (dot) dot.className = 'status-dot resting';
                if (text) text.textContent = 'EN DESCANSO · Inactivo';
                if (desc) desc.textContent = 'Estás en modo descanso. No se te asignarán nuevos pedidos. Puedes continuar y entregar tus pedidos asignados normalmente.';
                btn.className = 'btn btn-success rounded-pill px-4 py-2 fw-bold d-inline-flex align-items-center gap-2 shadow-sm';
                btn.innerHTML = '<i class="bi bi-play-circle-fill"></i> <span id="btnToggleText">Conectarme (En Línea)</span>';
            }

            mostrarToastDisponibilidad(data.message, estaEnLinea ? 'success' : 'warning');
        } else {
            alert(data.message || 'Error al actualizar disponibilidad.');
            btn.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Reintentar';
        }
    })
    .catch(err => {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-exclamation-triangle"></i> Error';
        console.error(err);
    });
}

function mostrarToastDisponibilidad(msg, tipo) {
    const el = document.getElementById('disponibilidadToast');
    const msgEl = document.getElementById('disponibilidadToastMsg');
    if (!el || !msgEl) return;
    
    el.className = `toast align-items-center text-white border-0 shadow-lg ${tipo === 'success' ? 'bg-success' : 'bg-warning text-dark'}`;
    msgEl.textContent = msg;
    if (typeof bootstrap !== 'undefined' && bootstrap.Toast) {
        const toast = new bootstrap.Toast(el, { delay: 4500 });
        toast.show();
    } else {
        el.style.display = 'block';
        setTimeout(() => { el.style.display = 'none'; }, 4500);
    }
}
</script>
}
