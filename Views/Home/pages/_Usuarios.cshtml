                                <button type="button" class="btn btn-sm position-absolute top-50 end-0 translate-middle-y me-2 border-0 bg-transparent text-muted" onclick="togglePass('passwordEditar', this)" title="Ver contraseña">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                            <small class="text-muted">Déjala vacía si no quieres cambiar la contraseña actual.</small>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="estadoEditar" name="Estado" value="true" checked />
                                <label class="form-check-label small fw-semibold" for="estadoEditar" style="color: var(--t-base);">
                                    Usuario Activo (Permite el inicio de sesión)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn--ghost" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn--primary">
                        <i class="bi bi-person-plus-fill me-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ================= MODAL DE CONFIRMACIÓN (GLASSMORPHISM) ================= *@
<div class="modal fade" id="glassConfirmModal" tabindex="-1" aria-labelledby="glassConfirmLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content modal-glass">

        <div class="modal-header">
          <h5 class="modal-title" id="glassConfirmLabel">¿Desactivar usuario?</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
        </div>
        <div class="modal-body">
          <p style="color: var(--t-muted); font-size: 13px; margin: 0;" id="glassConfirmTexto">
            Esta acción desactivará al usuario seleccionado. Podrás reactivarlo cuando quieras desde el listado.
          </p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn--ghost" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" id="btnConfirmarEliminar" class="btn btn--ghost"
            style="color: var(--danger); border-color: var(--danger);" onclick="confirmarDesactivarUsuario()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
            </svg>
            Desactivar
          </button>
        </div>
      </div>
    </div>
  </div>

@section Scripts {
    <script>
    function validarFormulario(form) {
        if (!form) return false;

        const requiredFields = form.querySelectorAll("input[required], select[required]");
        let valido = true;

        requiredFields.forEach(function (campo) {
            if (!campo.value.trim()) {
                campo.classList.add("is-invalid");
                valido = false;
            } else {
                campo.classList.remove("is-invalid");
            }
        });

        if (!valido) {
            form.reportValidity();
        }

        return valido;
    }

    function showUsuario(uuid) {
        const fila = document.querySelector(`.fila-usuario[data-uuid="${uuid}"]`);
        if (!fila) return;

        document.querySelectorAll(".fila-usuario").forEach(function (row) {
            row.classList.remove("table-active");
        });

        fila.classList.add("table-active");

        const startY = window.scrollY;
        const rect = fila.getBoundingClientRect();
        const targetY = startY + rect.top - (window.innerHeight / 2 - rect.height / 2);
        const duration = 180;

        function animarScroll(inicio, fin, tiempoActual) {
            const progreso = Math.min(tiempoActual / duration, 1);
            const ease = 1 - Math.pow(1 - progreso, 3);
            window.scrollTo({ top: inicio + (fin - inicio) * ease, behavior: "auto" });

            if (progreso < 1) {
                requestAnimationFrame((ts) => animarScroll(inicio, fin, ts - startTime));
            }
        }

        const startTime = performance.now();
        requestAnimationFrame((ts) => animarScroll(startY, targetY, ts - startTime));
    }

    function createUsuario() {
        const form = document.querySelector("#modalCrear form");
        if (!form) return;

        if (!validarFormulario(form)) return;

        form.submit();
    }

    function editUsuario(event) {
        const button = event?.relatedTarget || document.querySelector(".btn-action-icon.edit.active");

        if (!button) return;

        const uuid = button.getAttribute("data-uuid");
        const nombre = button.getAttribute("data-nombre");
        const apellido = button.getAttribute("data-apellido");
        const email = button.getAttribute("data-email");
        const rol = button.getAttribute("data-rol");
        const estado = button.getAttribute("data-estado");

        const uuidInput = document.getElementById("uuidEditar");
        const nombreInput = document.getElementById("nombreEditar");
        const apellidoInput = document.getElementById("apellidoEditar");
        const emailInput = document.getElementById("emailEditar");
        const passwordInput = document.getElementById("passwordEditar");
        const estadoInput = document.getElementById("estadoEditar");
        const rolSelect = document.getElementById("rolEditar");

        if (uuidInput) uuidInput.value = uuid || "";
        if (nombreInput) nombreInput.value = nombre || "";
        if (apellidoInput) apellidoInput.value = apellido || "";
        if (emailInput) emailInput.value = email || "";
        if (passwordInput) passwordInput.value = "";
        if (estadoInput) estadoInput.checked = String(estado).toLowerCase() === "true";
        if (rolSelect) {
            const valorRol = (rol || "cliente").toLowerCase();
            const rolesValidos = ["cliente", "empleado", "repartidor", "administrador"];
            rolSelect.value = rolesValidos.includes(valorRol) ? valorRol.charAt(0).toUpperCase() + valorRol.slice(1) : "Cliente";
        }

    }

    function updateUsuario(uuid) {
        const form = document.querySelector("#modalEditar form");
        if (!form) return;

        if (uuid && form.querySelector("#uuidEditar")) {
            form.querySelector("#uuidEditar").value = uuid;
        }

        if (!validarFormulario(form)) return;

        form.submit();
    }

    function activarUsuario(uuid) {
        const form = document.querySelector(`form.toggle-estado-form[data-usuario-id="${uuid}"]`);
        if (!form) return;

        const activo = form.dataset.estado === "true";
        if (activo) {
            if (!confirm("Este usuario ya está activo. ¿Deseas cambiar su estado?")) return;
        }

        form.submit();
    }

    function desactivarUsuario(uuid) {
        const form = document.querySelector(`form.toggle-estado-form[data-usuario-id="${uuid}"]`);
        if (!form) return;

        const activo = form.dataset.estado === "true";
        if (!activo) {
            if (!confirm("Este usuario ya está inactivo. ¿Deseas cambiar su estado?")) return;
        }

        form.submit();
    }

    function togglePass(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector("i");

        if (!input || !icon) return;

        if (input.type === "password") {
            input.type = "text";
            icon.classList.remove("bi-eye");
            icon.classList.add("bi-eye-slash");
        } else {
            input.type = "password";
            icon.classList.remove("bi-eye-slash");
            icon.classList.add("bi-eye");
        }
    }

    function copiarUuid(uuid, btn) {
        if (!uuid || !navigator.clipboard) return;

        navigator.clipboard.writeText(uuid).then(function () {
            const icon = btn.querySelector("i");
            if (!icon) return;

            icon.classList.remove("bi-clipboard");
            icon.classList.add("bi-check2");

            setTimeout(function () {
                icon.classList.remove("bi-check2");
                icon.classList.add("bi-clipboard");
            }, 1500);
        });
    }

    function filtrarUsuarios() {
        const inputFiltro = document.getElementById("filtroUsuarios");
        const selectRol = document.getElementById("filtroRol");
        const filas = document.querySelectorAll(".fila-usuario");

        const texto = inputFiltro?.value.toLowerCase().trim() || "";
        const rol = selectRol?.value.toLowerCase().trim() || "";

        filas.forEach(function (fila) {
            const contenido = fila.textContent.toLowerCase();
            const filaRol = fila.getAttribute("data-rol")?.toLowerCase() || "";

            const coincideTexto = !texto || contenido.includes(texto);
            const coincideRol = !rol || filaRol === rol || filaRol.includes(rol);

            fila.style.display = coincideTexto && coincideRol ? "" : "none";
        });
    }

    function cargarFecha() {
        const fechaEl = document.getElementById("heroDate");
        if (!fechaEl) return;

        const hoy = new Date();
        const opciones = { day: "numeric", month: "long", year: "numeric" };
        fechaEl.innerHTML = `<i class="bi bi-calendar3 me-1"></i> ` + hoy.toLocaleDateString("es-ES", opciones);
    }

    function autoOcultarAlertas() {
        document.querySelectorAll(".alert-dismissible").forEach(function (alertEl) {
            setTimeout(function () {
                const instancia = bootstrap.Alert.getOrCreateInstance(alertEl);
                instancia.close();
            }, 4000);
        });
    }

    let uuidADesactivar = null;

    async function confirmarDesactivarUsuario() {
        if (!uuidADesactivar) return;

        const form = document.querySelector(`.desactivar-form[data-usuario-id="${uuidADesactivar}"]`);
        if (!form) return;

        const btnConfirmar = document.querySelector("#glassConfirmModal .btn-danger");
        if (btnConfirmar) btnConfirmar.disabled = true;

        const formData = new FormData(form);
        const res = await window.postFormAjax(form.action, formData);

        if (btnConfirmar) btnConfirmar.disabled = false;

        const modalEl = document.getElementById("glassConfirmModal");
        if (modalEl) {
            const modalInstance = bootstrap.Modal.getInstance(modalEl);
            if (modalInstance) modalInstance.hide();
        }

        if (res.success) {
            window.showAppToast(res.message, "success");
            // Actualizar fila del usuario
            const tr = form.closest("tr");
            if (tr) {
                const toggleForm = tr.querySelector(".toggle-estado-form");
                if (toggleForm) {
                    toggleForm.dataset.estado = "false";
                    toggleForm.innerHTML = `
                        <input type="hidden" name="__RequestVerificationToken" value="${formData.get('__RequestVerificationToken') || ''}" />
                        <button type="submit" class="tag t-unavail border-0" title="Click para activar">
                            <span class="tag-dot"></span> Inactivo
                        </button>
                    `;
                }
                const editBtn = tr.querySelector(".btn-action-icon.edit");
                if (editBtn) editBtn.setAttribute("data-estado", "false");
            }
        } else {
            window.showAppToast(res.message || "Error al desactivar el usuario.", "error");
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        cargarFecha();
        autoOcultarAlertas();

        document.getElementById("filtroUsuarios")?.addEventListener("input", filtrarUsuarios);
        document.getElementById("filtroRol")?.addEventListener("change", filtrarUsuarios);

        const editModal = document.getElementById("modalEditar");
        if (editModal) {
            editModal.addEventListener("show.bs.modal", editUsuario);
        }

        const confirmModal = document.getElementById("glassConfirmModal");
        if (confirmModal) {
            confirmModal.addEventListener("show.bs.modal", function (event) {
                const boton = event.relatedTarget;
                uuidADesactivar = boton?.getAttribute("data-uuid") || null;
                const nombre = boton?.getAttribute("data-nombre") || "este usuario";

                const texto = document.getElementById("glassConfirmTexto");
                if (texto) {
                    texto.textContent = `Esta acción desactivará a ${nombre}. Podrás reactivarlo cuando quieras desde el listado.`;
                }
            });
        }

        // Crear Usuario vía AJAX
        const formCrear = document.querySelector("#modalCrear form");
        if (formCrear) {
            formCrear.addEventListener("submit", async function (event) {
                event.preventDefault();
                if (!validarFormulario(formCrear)) return;

                const btnSubmit = formCrear.querySelector("button[type='submit']");
                if (btnSubmit) { btnSubmit.disabled = true; btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Guardando...'; }

                const formData = new FormData(formCrear);
                const res = await window.postFormAjax(formCrear.action || "/Usuario/Create", formData);

                if (btnSubmit) { btnSubmit.disabled = false; btnSubmit.innerHTML = '<span>Guardar Usuario</span><i class="bi bi-arrow-right ms-2"></i>'; }

                if (res.success) {
                    window.showAppToast(res.message, "success");
                    formCrear.reset();
                    const modalEl = document.getElementById("modalCrear");
                    if (modalEl) {
                        const modalInstance = bootstrap.Modal.getInstance(modalEl);
                        if (modalInstance) modalInstance.hide();
                    }
                    setTimeout(() => location.reload(), 600);
                } else {
                    window.showAppToast(res.message || "Error al crear usuario", "error");
                }
            });
        }

        // Editar Usuario vía AJAX
        const formEditar = document.querySelector("#modalEditar form");
        if (formEditar) {
            formEditar.addEventListener("submit", async function (event) {
                event.preventDefault();
                if (!validarFormulario(formEditar)) return;

                const btnSubmit = formEditar.querySelector("button[type='submit']");
                if (btnSubmit) { btnSubmit.disabled = true; btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Actualizando...'; }

                const formData = new FormData(formEditar);
                const res = await window.postFormAjax(formEditar.action || "/Usuario/Update", formData);

                if (btnSubmit) { btnSubmit.disabled = false; btnSubmit.innerHTML = '<span>Guardar Cambios</span><i class="bi bi-check-lg ms-2"></i>'; }

                if (res.success) {
                    window.showAppToast(res.message, "success");
                    const modalEl = document.getElementById("modalEditar");
                    if (modalEl) {
                        const modalInstance = bootstrap.Modal.getInstance(modalEl);
                        if (modalInstance) modalInstance.hide();
                    }
                    setTimeout(() => location.reload(), 600);
                } else {
                    window.showAppToast(res.message || "Error al actualizar usuario", "error");
                }
            });
        }

        document.querySelectorAll(".btn-action-icon.edit").forEach(function (btn) {
            btn.addEventListener("click", function () {
                document.querySelectorAll(".btn-action-icon.edit").forEach(function (item) {
                    item.classList.remove("active");
                });
                btn.classList.add("active");
            });
        });

        // Alternar Estado vía AJAX
        document.querySelectorAll(".toggle-estado-form").forEach(function (form) {
            form.addEventListener("submit", async function (event) {
                event.preventDefault();
                const estadoActual = this.dataset.estado === "true";
                const accion = estadoActual ? "desactivar" : "activar";
                const nombre = this.closest("tr")?.querySelector(".cell-name")?.textContent?.trim() || "este usuario";

                if (!confirm(`¿Seguro que quieres ${accion} a ${nombre}?`)) {
                    return;
                }

                const formData = new FormData(form);
                const res = await window.postFormAjax(form.action, formData);

                if (res.success) {
                    window.showAppToast(res.message, "success");
                    const nuevoEstado = res.estado;
                    form.dataset.estado = nuevoEstado ? "true" : "false";
                    form.innerHTML = `
                        <input type="hidden" name="__RequestVerificationToken" value="${formData.get('__RequestVerificationToken') || ''}" />
                        <button type="submit" class="tag ${nuevoEstado ? "t-active" : "t-unavail"} border-0" title="Click para ${nuevoEstado ? "desactivar" : "activar"}">
                            <span class="tag-dot"></span> ${nuevoEstado ? "Activo" : "Inactivo"}
                        </button>
                    `;
                    const tr = form.closest("tr");
                    if (tr) {
                        const editBtn = tr.querySelector(".btn-action-icon.edit");
                        if (editBtn) editBtn.setAttribute("data-estado", nuevoEstado ? "true" : "false");
                    }
                } else {
                    window.showAppToast(res.message || "Error al actualizar estado.", "error");
                }
            });
        });
    });
    </script>
}