                        </div>

                        <div class="col-12">
                            <label class="form-label" for="emailEditar">Correo Electrónico</label>
                            <input type="email" class="form-control" id="emailEditar" name="Email" placeholder="juan.perez@drogueria.com" required maxlength="60" pattern="^[a-zA-Z0-9._%+-]+@@[a-zA-Z0-9.-]+\.(com|co|org|net|edu|gov|es|io|[a-zA-Z]{2,})$" title="Ejemplo: correo@@dominio.com o .co" />
                        </div>

                        <div class="col-sm-6">
                            <label class="form-label" for="rolEditar">Rol del Sistema</label>
                            <select class="form-select" id="rolEditar" name="Rol" required>
                                <option value="Cliente" selected>Cliente</option>
                                <option value="Empleado">Empleado</option>
                                <option value="Repartidor">Repartidor</option>
                                <option value="Administrador">Administrador</option>
                            </select>
                        </div>


                        <div class="col-sm-6">
                            <label class="form-label" for="passwordEditar">Contraseña</label>
                            <div class="position-relative">
