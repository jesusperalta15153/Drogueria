                    <h5 class="modal-title" id="modalEditarLabel">Editar Usuario</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form method="post" asp-controller="Usuario" asp-action="Update">
