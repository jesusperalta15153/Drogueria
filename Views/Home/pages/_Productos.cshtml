                            <label class="form-label" for="editarStock">Existencia <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="editarStock" name="Stock"
                                   placeholder="0" min="0" max="50000" required />
                        </div>

                        <!-- Stock Mínimo (Límite Alerta) -->
                        <div class="col-sm-4">
                            <label class="form-label" for="editarStockMinimo">Límite Alerta <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" id="editarStockMinimo" name="StockMinimo"
                                   placeholder="5" min="0" max="5000" required />
                        </div>

                        <!-- Límite Máximo Por Pedido -->
                        <div class="col-sm-4">
                            <label class="form-label" for="editarLimiteMaximo">Máx. pastillas/ud. por pedido</label>
                            <input type="number" class="form-control" id="editarLimiteMaximo" name="LimiteMaximoPorPedido"
                                   placeholder="Sin límite" min="1" max="100" />
                        </div>

                        <!-- Imagen -->
                        <div class="col-12">
                            <label class="form-label">Imagen actual</label>
                            <div id="editarImagenPreview" class="mb-2"></div>
                            <input type="file" class="form-control" id="editarImagenFile" name="imagenFile"
                                   accept=".jpg,.jpeg,.png,.webp,.gif" />
                            <small class="text-muted">Dejar vacío para conservar la imagen actual</small>
