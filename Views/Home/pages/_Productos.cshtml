                        </div>

                        <!-- Descripción -->
                        <div class="col-12">
                            <label class="form-label" for="editarDescripcion">Descripción Detallada</label>
                            <textarea class="form-control" id="editarDescripcion" name="Descripcion"
                                      placeholder="Descripción completa del medicamento o producto (indicaciones, posología, contraindicaciones, etc.)..." rows="4" maxlength="2000" style="resize: vertical;"></textarea>
