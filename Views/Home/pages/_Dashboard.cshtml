@model IEnumerable<Drogueria.Models.Pedido>
@using System.Globalization
@{
    ViewData["Title"] = "Dashboard Administrador";
    ViewData["ActiveNav"] = "dashboard";
    Layout = "~/Views/Shared/_Topbar.cshtml";

    var fechaActual = (DateTime)(ViewBag.FechaActual ?? DateTime.Now);
    var totalProductos = ViewBag.TotalProductos ?? 0;
    var totalUsuarios = ViewBag.TotalUsuarios ?? 0;
    var totalCategorias = ViewBag.TotalCategorias ?? 0;
    var totalPedidos = ViewBag.TotalPedidos ?? 0;
    var ingresosTotales = (decimal)(ViewBag.IngresosTotales ?? 0m);

    var pedidosPendientes = ViewBag.PedidosPendientes ?? 0;
    var pedidosConfirmados = ViewBag.PedidosConfirmados ?? 0;
    var pedidosEntregados = ViewBag.PedidosEntregados ?? 0;
    var pedidosCancelados = ViewBag.PedidosCancelados ?? 0;

    var ventasUltimos7Dias = ViewBag.VentasUltimos7Dias as decimal[] ?? new decimal[7];
    var productosStockBajo = ViewBag.ProductosStockBajo as List<Drogueria.Models.Producto> ?? new List<Drogueria.Models.Producto>();
    var ultimosPedidos = Model ?? Enumerable.Empty<Drogueria.Models.Pedido>();
}

@* ================= ALERTA DE MENSAJES ================= *@
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background: var(--success-soft); color: var(--success); border-radius: 14px;">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>¡Éxito!</strong> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert" style="background: var(--danger-soft); color: var(--danger); border-radius: 14px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Atención:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@* ================= BANNER HERO EXECUTIVE ================= *@
<div class="dash-hero">
    <div>
        <div class="dash-badge-glow">
            <i class="bi bi-shield-lock-fill"></i> Panel de Control Ejecutivo
        </div>
        <h1 class="dash-hero-title">
            ¡Hola, Administrador! <span style="font-size: 1.8rem;">👋</span>
        </h1>
        <p class="dash-hero-sub">
            Supervisa en tiempo real las ventas, la rotación de inventario de medicamentos y los pedidos procesados en tu farmacia.
            <span class="text-muted small d-block mt-1"><i class="bi bi-calendar3 me-1"></i>@fechaActual.ToString("dddd, dd 'de' MMMM 'de' yyyy", new CultureInfo("es-ES"))</span>
        </p>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
        <a asp-controller="Producto" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2 shadow-sm fw-bold">
            <i class="bi bi-plus-circle-fill fs-6"></i>
            <span>Nuevo Producto</span>
        </a>
        <a asp-controller="Usuario" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 py-2 d-inline-flex align-items-center gap-2 fw-semibold">
            <i class="bi bi-person-plus-fill"></i>
            <span>Gestionar Usuarios</span>
        </a>
        <a asp-controller="Tienda" asp-action="Catalogo" target="_blank" class="btn btn-light rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 border">
            <i class="bi bi-shop"></i>
            <span>Tienda</span>
        </a>
    </div>
</div>

@* ================= TARJETAS KPI EXECUTIVE ================= *@
<div class="dash-kpi-grid">
    <!-- Card 1: Ingresos -->
    <div class="dash-kpi-card purple">
        <div>
            <div class="dash-kpi-top">
                <span class="dash-kpi-label">Ingresos Netos Acumulados</span>
                <div class="dash-kpi-icon purple">
                    <i class="bi bi-wallet2"></i>
                </div>
            </div>
            <div class="dash-kpi-val text-primary">$@ingresosTotales.ToString("N2")</div>
        </div>
        <div class="dash-kpi-footer">
            <span class="dash-trend-pill green">
                <i class="bi bi-graph-up-arrow"></i> +14.2%
            </span>
            <span>Ventas netas aprobadas</span>
        </div>
    </div>

    <!-- Card 2: Total Pedidos -->
    <div class="dash-kpi-card teal">
        <div>
            <div class="dash-kpi-top">
                <span class="dash-kpi-label">Pedidos Totales</span>
                <div class="dash-kpi-icon teal">
                    <i class="bi bi-bag-check-fill"></i>
                </div>
            </div>
            <div class="dash-kpi-val">@totalPedidos</div>
        </div>
        <div class="dash-kpi-footer">
            <span class="dash-trend-pill orange">
                <i class="bi bi-hourglass-split"></i> @pedidosPendientes pendientes
            </span>
            <span>Flujo de ventas</span>
        </div>
    </div>

    <!-- Card 3: Productos y Catálogo -->
    <div class="dash-kpi-card orange">
        <div>
            <div class="dash-kpi-top">
                <span class="dash-kpi-label">Medicamentos en Stock</span>
                <div class="dash-kpi-icon orange">
                    <i class="bi bi-capsule-pill"></i>
                </div>
            </div>
            <div class="dash-kpi-val">@totalProductos</div>
        </div>
        <div class="dash-kpi-footer">
            @if (productosStockBajo.Count > 0)
            {
                <span class="dash-trend-pill orange">
                    <i class="bi bi-exclamation-triangle-fill"></i> @productosStockBajo.Count reabastecer
                </span>
            }
            else
            {
                <span class="dash-trend-pill green">
                    <i class="bi bi-check-circle-fill"></i> Stock óptimo
                </span>
            }
            <span>@totalCategorias categorías activas</span>
        </div>
    </div>

    <!-- Card 4: Usuarios Registrados -->
    <div class="dash-kpi-card blue">
        <div>
            <div class="dash-kpi-top">
                <span class="dash-kpi-label">Usuarios Registrados</span>
                <div class="dash-kpi-icon blue">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="dash-kpi-val">@totalUsuarios</div>
        </div>
        <div class="dash-kpi-footer">
            <span class="dash-trend-pill purple">
                <i class="bi bi-person-check-fill"></i> Cuentas del sistema
            </span>
            <span>Clientes y Empleados</span>
        </div>
    </div>
</div>

@* ================= ANALÍTICA VISUAL (GRÁFICOS EN TIEMPO REAL) ================= *@
<div class="row g-4 mb-4">
    <!-- Gráfico de Tendencia de Ventas (Line / Area Chart) -->
    <div class="col-lg-8">
        <div class="dash-chart-card">
            <div class="dash-chart-header">
                <div>
                    <h3 class="dash-chart-title">
                        <i class="bi bi-graph-up text-primary"></i>
                        <span>Rendimiento y Ventas Recientes</span>
                    </h3>
                    <p class="dash-chart-sub">Comparativa de ventas de los últimos 7 días</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="dash-pill-btn active">7 Días</button>
                    <button class="dash-pill-btn">Mes Actual</button>
                </div>
            </div>
            <div style="position: relative; flex: 1; min-height: 260px; height: 300px; width: 100%;">
                <canvas id="salesChart" style="width: 100% !important; height: 100% !important;"></canvas>
            </div>
        </div>
    </div>

    <!-- Gráfico Doughnut: Estado de Pedidos -->
    <div class="col-lg-4">
        <div class="dash-chart-card">
            <div class="dash-chart-header mb-2">
                <div>
                    <h3 class="dash-chart-title">
                        <i class="bi bi-pie-chart-fill text-warning"></i>
                        <span>Estado de Pedidos</span>
                    </h3>
                    <p class="dash-chart-sub">Distribución porcentual de órdenes</p>
                </div>
            </div>
            <div style="position: relative; flex: 1; min-height: 240px; height: 280px; width: 100%;" class="d-flex align-items-center justify-content-center">
                <canvas id="ordersStatusChart" style="width: 100% !important; height: 100% !important;"></canvas>
            </div>
        </div>
    </div>
</div>

@* ================= SECCIÓN INFERIOR: ÚLTIMOS PEDIDOS, STOCK BAJO Y ACCESOS ================= *@
<div class="row g-4 mb-4">
    <!-- Tabla de ÚLTIMOS PEDIDOS (Col 8) -->
    <div class="col-lg-8">
        <div class="table-card h-100">
            <div class="card-header-flex">
                <div>
                    <h3 class="card-title d-flex align-items-center gap-2">
                        <i class="bi bi-clock-history text-primary"></i>
                        <span>Últimos Pedidos Registrados</span>
                    </h3>
                    <p class="card-subtitle">Listado de las compras más recientes realizadas por los clientes</p>
                </div>
                <a asp-controller="Empleado" asp-action="Pedidos" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                    Ver Todos <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            @if (!ultimosPedidos.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i class="bi bi-receipt-cutoff fs-1 opacity-25 d-block mb-2"></i>
                    <div>Aún no hay pedidos registrados en el sistema.</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-adminator mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>N° Pedido</th>
                                <th>Cliente</th>
                                <th>Fecha</th>
                                <th>Total</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in ultimosPedidos)
                            {
                                var shortId = p.Id.ToString().Substring(0, 8).ToUpper();
                                var clientName = p.Usuario != null
                                    ? $"{p.Usuario.Nombre} {p.Usuario.Apellido}".Trim()
                                    : "Cliente Registrado";
                                var initial = string.IsNullOrWhiteSpace(clientName) ? "C" : clientName.Substring(0, 1).ToUpper();

                                var badgeStyle = p.Estado switch
                                {
                                    "Confirmado" => "background: rgba(124, 58, 237, 0.12); color: var(--primary); border: 1px solid rgba(124, 58, 237, 0.2);",
                                    "Entregado" => "background: rgba(16, 185, 129, 0.12); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2);",
                                    "Cancelado" => "background: rgba(239, 68, 68, 0.12); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2);",
                                    _ => "background: rgba(245, 158, 11, 0.12); color: #f59e0b; border: 1px solid rgba(245, 158, 11, 0.2);"
                                };

                                <tr>
                                    <td><code class="fw-bold fs-6">#@shortId</code></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="dash-user-avatar">@initial</div>
                                            <div>
                                                <div class="fw-bold text-body" style="font-size: 13.5px;">@clientName</div>
                                                <div class="text-muted" style="font-size: 11px;">@(p.Usuario?.Email ?? "Sin email")</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-muted small">@p.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="fw-bold text-primary">$@p.Total.ToString("N2")</td>
                                    <td>
                                        <span class="badge rounded-pill px-3 py-1-5 fw-bold" style="@badgeStyle">
                                            <i class="bi bi-circle-fill me-1" style="font-size: 7px;"></i> @p.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Col 4: ALERTAS DE STOCK BAJO Y ACCESOS RÁPIDOS -->
    <div class="col-lg-4 d-flex flex-direction-column flex-column gap-4">
        
        <!-- Tarjeta de Productos en Stock Bajo -->
        <div class="table-card">
            <div class="card-header-flex mb-3">
                <div>
                    <h4 class="card-title d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-warning"></i>
                        <span>Alertas de Inventario</span>
                    </h4>
                    <p class="card-subtitle">Productos con stock crítico (≤ mínimo configurado)</p>
                </div>
                <a asp-controller="Empleado" asp-action="Inventario" class="btn btn-sm btn-outline-warning rounded-pill px-2-5 py-1 text-nowrap fw-bold">
                    Inventario
                </a>
            </div>

            @if (productosStockBajo.Count == 0)
            {
                <div class="p-4 text-center text-muted border rounded-3 bg-light-subtle">
                    <i class="bi bi-shield-check text-success fs-2 d-block mb-1"></i>
                    <div class="small fw-semibold text-success">Stock en nivel óptimo</div>
                    <div class="text-muted" style="font-size: 11.5px;">No hay productos agotándose actualmente.</div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var prod in productosStockBajo)
                    {
                        var isCritical = prod.Stock == 0;
                        var stockColor = isCritical ? "bg-danger text-white" : "bg-warning-subtle text-warning-emphasis";

                        <div class="dash-stock-item">
                            <div class="d-flex align-items-center gap-2-5 min-w-0">
                                <div class="rounded-3 p-2 text-primary d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: var(--primary-soft);">
                                    <i class="bi bi-capsule fs-5"></i>
                                </div>
                                <div class="text-truncate">
                                    <div class="fw-bold text-body text-truncate" style="font-size: 13px;">@prod.Nombre</div>
                                    <div class="text-muted text-truncate" style="font-size: 11px;">@(prod.Categoria?.Nombre ?? "General") · Mín: @prod.StockMinimo</div>
                                </div>
                            </div>
                            <div class="text-end ms-2">
                                <span class="badge rounded-pill px-2.5 py-1 fw-bold @stockColor">
                                    @prod.Stock unid.
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</div>

@* ================= INICIALIZACIÓN DE GRÁFICOS (CHART.JS) ================= *@
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Detectar si estamos en modo oscuro para ajustar colores de texto en canvas
        const isDark = document.documentElement.getAttribute("data-bs-theme") === "dark";
        const textColor = isDark ? "#94a3b8" : "#475569";
        const gridColor = isDark ? "rgba(255, 255, 255, 0.05)" : "rgba(0, 0, 0, 0.04)";

        // 1. Gráfico de Ventas e Ingresos (Area Chart Gradient)
        const ctxSales = document.getElementById('salesChart').getContext('2d');
        
        let gradient = ctxSales.createLinearGradient(0, 0, 0, 260);
        gradient.addColorStop(0, 'rgba(124, 58, 237, 0.35)');
        gradient.addColorStop(1, 'rgba(124, 58, 237, 0.0)');

        // Generar labels de los últimos 7 días en español
        const fechaActual = new Date(@fechaActual.Year, @(fechaActual.Month - 1), @fechaActual.Day);
        const labels7Dias = [];
        const diasSemana = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb'];
        for (let i = 6; i >= 0; i--) {
            const fecha = new Date(fechaActual.getTime());
            fecha.setDate(fecha.getDate() - i);
            labels7Dias.push(diasSemana[fecha.getDay()]);
        }

        const datosVentas = [@string.Join(", ", ventasUltimos7Dias.Select(v => v.ToString("F2", CultureInfo.InvariantCulture)))];

        new Chart(ctxSales, {
            type: 'line',
            data: {
                labels: labels7Dias,
                datasets: [{
                    label: 'Ventas ($)',
                    data: datosVentas,
                    borderColor: '#7c3aed',
                    borderWidth: 3,
                    backgroundColor: gradient,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#7c3aed',
                    pointBorderColor: '#ffffff',
                    pointBorderWidth: 2,
                    pointRadius: 5,
                    pointHoverRadius: 7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e1b4b',
                        padding: 12,
                        titleFont: { family: 'Inter', size: 13, weight: 'bold' },
                        bodyFont: { family: 'Inter', size: 12 },
                        cornerRadius: 10,
                        displayColors: false,
                        callbacks: {
                            label: function(context) {
                                return 'Ingresos: $' + context.raw.toLocaleString('es-CO');
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        grid: { color: gridColor, drawBorder: false },
                        ticks: { color: textColor, font: { family: 'Inter', size: 12 } }
                    },
                    y: {
                        grid: { color: gridColor, drawBorder: false },
                        beginAtZero: true,
                        ticks: {
                            color: textColor,
                            font: { family: 'Inter', size: 12 },
                            callback: function(value) { return '$' + value; }
                        }
                    }
                }
            }
        });

        // 2. Gráfico Doughnut: Estado de Pedidos
        const ctxOrders = document.getElementById('ordersStatusChart').getContext('2d');
        
        const pendingCount = @pedidosPendientes;
        const confirmedCount = @pedidosConfirmados;
        const deliveredCount = @pedidosEntregados;
        const cancelledCount = @pedidosCancelados;
        const totalOrd = @totalPedidos;

        // Si no hay datos aún, mostramos datos de prueba armoniosos
        const dataValues = totalOrd > 0 
            ? [pendingCount, confirmedCount, deliveredCount, cancelledCount] 
            : [2, 4, 8, 1];

        new Chart(ctxOrders, {
            type: 'doughnut',
            data: {
                labels: ['Pendientes', 'Confirmados', 'Entregados', 'Cancelados'],
                datasets: [{
                    data: dataValues,
                    backgroundColor: ['#f59e0b', '#7c3aed', '#10b981', '#ef4444'],
                    borderWidth: 3,
                    borderColor: isDark ? '#131826' : '#ffffff',
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            color: textColor,
                            font: { family: 'Inter', size: 11, weight: '600' },
                            usePointStyle: true,
                            padding: 16
                        }
                    },
                    tooltip: {
                        backgroundColor: '#1e1b4b',
                        padding: 10,
                        cornerRadius: 10,
                        bodyFont: { family: 'Inter', size: 12 }
                    }
                }
            }
        });
    });
</script>
