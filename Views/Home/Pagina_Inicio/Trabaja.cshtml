        function enviarPostulacion(evento, rol) {
            evento.preventDefault();
            const form = rol === "empleado" ? document.getElementById("formEmpleado") : document.getElementById("formRepartidor");

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            // Validar Hoja de Vida obligatoria
            if (rol === "empleado") {
                const cvInput = document.getElementById("empArchivoCv");
                if (!cvInput || !cvInput.files || cvInput.files.length === 0) {
                    alert("Por favor adjunta tu Hoja de Vida en formato PDF antes de enviar tu postulación.");
                    const drop = document.getElementById("dropzoneEmp");
                    if (drop) {
                        drop.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        drop.style.borderColor = "#ef4444";
