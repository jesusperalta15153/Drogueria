@section Scripts {
    <script>
        const NUMERO_WHATSAPP = "573135958228";
        let rolSeleccionado = "empleado";

        function cambiarRol(rol) {
            rolSeleccionado = rol;
            const tabEmp = document.getElementById("tabRolEmpleado");
            const tabRep = document.getElementById("tabRolRepartidor");
            const formEmp = document.getElementById("formEmpleado");
            const formRep = document.getElementById("formRepartidor");

            if (rol === "empleado") {
                tabEmp.classList.add("activo");
                tabEmp.setAttribute("aria-selected", "true");
                tabRep.classList.remove("activo");
                tabRep.setAttribute("aria-selected", "false");

                formEmp.style.display = "block";
                formRep.style.display = "none";
            } else {
                tabRep.classList.add("activo");
                tabRep.setAttribute("aria-selected", "true");
                tabEmp.classList.remove("activo");
                tabEmp.setAttribute("aria-selected", "false");

                formRep.style.display = "block";
                formEmp.style.display = "none";
            }
        }

        function cambiarTipoVehiculo(tipo) {
            const selLic = document.getElementById("repLicencia");
            const campoDocs = document.getElementById("campoDocumentosVehiculo");
            const inputDocs = document.getElementById("repArchivoDocs");

            if (!selLic) return;

            selLic.innerHTML = "";

            if (!tipo) {
                selLic.disabled = true;
                const opt = document.createElement("option");
                opt.value = "";
                opt.textContent = "Selecciona primero un tipo de vehículo";
                opt.selected = true;
                opt.disabled = true;
                selLic.appendChild(opt);

                if (campoDocs) campoDocs.style.display = "none";
                if (inputDocs) inputDocs.value = "";
                return;
            }

            if (tipo.includes("Bicicleta")) {
                selLic.disabled = false;
                const opt = document.createElement("option");
                opt.value = "No aplica (Bicicleta)";
                opt.textContent = "No aplica (Bicicleta / Sin motor)";
                opt.selected = true;
                selLic.appendChild(opt);

                if (campoDocs) campoDocs.style.display = "none";
                if (inputDocs) {
                    quitarArchivo('repArchivoDocs', 'previewDocsRep');
                }
            } else if (tipo.includes("Motocicleta")) {
                selLic.disabled = false;

                const placeholder = document.createElement("option");
                placeholder.value = "";
                placeholder.textContent = "Selecciona tu categoría para moto";
                placeholder.selected = true;
                placeholder.disabled = true;
                selLic.appendChild(placeholder);

                const opcionesMoto = [
                    { val: "A2 (Motos de cualquier cilindraje)", label: "A2 (Motos de cualquier cilindraje)" },
                    { val: "A1 (Motos hasta 125 c.c.)", label: "A1 (Motos hasta 125 c.c.)" }
                ];

                opcionesMoto.forEach(item => {
                    const opt = document.createElement("option");
                    opt.value = item.val;
                    opt.textContent = item.label;
                    selLic.appendChild(opt);
                });

                if (campoDocs) campoDocs.style.display = "block";
            } else { // Automóvil / Furgón
                selLic.disabled = false;

                const placeholder = document.createElement("option");
                placeholder.value = "";
                placeholder.textContent = "Selecciona tu categoría de vehículo";
                placeholder.selected = true;
                placeholder.disabled = true;
                selLic.appendChild(placeholder);

                const opcionesCarro = [
                    { val: "B1 (Automóviles y camionetas particulares)", label: "B1 (Automóviles y camionetas particulares)" },
                    { val: "B2 (Camiones rígidos particulares)", label: "B2 (Camiones rígidos particulares)" },
                    { val: "C1 (Automóviles de servicio público)", label: "C1 (Automóviles de servicio público)" },
                    { val: "C2 (Camiones y furgones de servicio público)", label: "C2 (Camiones y furgones de servicio público)" }
                ];

                opcionesCarro.forEach(item => {
                    const opt = document.createElement("option");
                    opt.value = item.val;
                    opt.textContent = item.label;
                    selLic.appendChild(opt);
                });

                if (campoDocs) campoDocs.style.display = "block";
            }
        }

        function actualizarContador(textarea, targetId) {
            const contador = document.getElementById(targetId);
            if (contador) {
                const len = textarea.value.length;
                contador.textContent = `${len} / ${textarea.maxLength} caracteres`;
            }
        }

        function procesarArchivo(input, previewId, nombreId) {
            const file = input.files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert("El archivo supera el límite de 5MB. Por favor selecciona un documento más liviano.");
                    input.value = "";
                    return;
                }
                const preview = document.getElementById(previewId);
                const nombreEl = document.getElementById(nombreId);
                if (preview && nombreEl) {
                    nombreEl.textContent = `${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
                    preview.style.display = "flex";
                }
            }
        }

        function quitarArchivo(inputId, previewId) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(previewId);
            if (input) input.value = "";
            if (preview) preview.style.display = "none";
        }

