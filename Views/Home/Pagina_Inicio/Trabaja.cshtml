                            setTimeout(() => { dropDocs.style.borderColor = ""; }, 3000);
                        }
                        return;
                    }
                }

                const cvInput = document.getElementById("repArchivoCv");
                if (!cvInput || !cvInput.files || cvInput.files.length === 0) {
