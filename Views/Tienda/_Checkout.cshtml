@model List<Drogueria.Models.CarritoItem>
@{
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "Confirmar Pedido";
    ViewData["ActiveNav"] = "carrito";
    var direccion = ViewBag.DireccionEntrega as string ?? "";
    var subtotal = Model.Sum(i => i.Subtotal);
    var costoEnvio = subtotal >= 45000m ? 0m : 8000m;
    var propinaInicial = ViewBag.Propina != null ? (decimal)ViewBag.Propina : 1000m;
    var total = subtotal + costoEnvio + propinaInicial;
}

<style>
/* ── Tarjetas de método de pago ── */
.pago-card {
    border: 2px solid var(--border, #dee2e6);
    border-radius: 16px;
    padding: 18px 20px;
    cursor: pointer;
    transition: all .22s ease;
    background: var(--bg-card, #fff);
    position: relative;
    user-select: none;
}
.pago-card:hover { border-color: var(--primary, #0d6efd); box-shadow: 0 4px 18px rgba(13,110,253,.10); }
.pago-card.selected {
    border-color: var(--primary, #0d6efd);
    background: var(--primary-soft, #e8f0fe);
    box-shadow: 0 4px 18px rgba(13,110,253,.15);
}
.pago-card input[type="radio"] { display: none; }
.pago-check {
    width: 22px; height: 22px;
    border: 2px solid var(--border, #dee2e6);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    transition: all .18s;
    flex-shrink: 0;
}
.pago-card.selected .pago-check {
    background: var(--primary, #0d6efd);
    border-color: var(--primary, #0d6efd);
}
.pago-check::after {
    content: '';
    width: 9px; height: 9px;
    border-radius: 50%;
    background: #fff;
    display: none;
}
.pago-card.selected .pago-check::after { display: block; }

/* ── Sub-opciones tarjeta ── */
.sub-metodos {
    display: none;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border, #dee2e6);
    gap: 10px;
}
.pago-card.selected .sub-metodos { display: flex; }
.sub-btn {
    flex: 1; padding: 10px 8px;
    border: 2px solid var(--border, #dee2e6);
    border-radius: 10px; cursor: pointer;
    text-align: center; font-size: 13px;
    transition: all .18s; background: var(--bg-muted, #f8f9fa);
}
.sub-btn:hover { border-color: var(--primary, #0d6efd); }
.sub-btn.sel {
    border-color: var(--primary, #0d6efd);
    background: var(--primary-soft, #e8f0fe);
    color: var(--primary, #0d6efd); font-weight: 600;
}

/* ── Formulario de tarjeta ── */
#formTarjeta {
    display: none;
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--border, #dee2e6);
    animation: fadeIn .25s ease;
}
.pago-card.selected #formTarjeta { display: block; }
@@keyframes fadeIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }

/* ── Visualizador de tarjeta ── */
.card-preview {
    border-radius: 16px;
    padding: 22px 24px;
    color: #fff;
    min-height: 130px;
    position: relative;
    overflow: hidden;
    margin-bottom: 18px;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 60%, #0f3460 100%);
    box-shadow: 0 8px 32px rgba(0,0,0,.25);
    transition: background .4s ease;
}
.card-preview.visa   { background: linear-gradient(135deg, #1a56db 0%, #0e4fa8 60%, #0a3d8f 100%); }
.card-preview.master { background: linear-gradient(135deg, #eb5757 0%, #c0392b 50%, #922b21 100%); }
.card-preview::before {
    content: '';
    position: absolute; top: -40px; right: -40px;
    width: 160px; height: 160px;
    border-radius: 50%;
    background: rgba(255,255,255,.08);
}
.card-preview::after {
    content: '';
    position: absolute; bottom: -60px; left: -30px;
    width: 180px; height: 180px;
    border-radius: 50%;
    background: rgba(255,255,255,.05);
}
.card-brand-badge {
    font-size: 11px; font-weight: 700; letter-spacing: .12em;
    text-transform: uppercase; opacity: .8; margin-bottom: 8px;
    display: flex; align-items: center; gap: 8px;
}
.card-number-preview {
    font-size: 18px; font-weight: 600;
    letter-spacing: .18em; margin-bottom: 14px;
    font-family: 'Courier New', monospace;
    word-spacing: 8px;
}
.card-meta { display: flex; justify-content: space-between; font-size: 12px; opacity: .8; }
.card-meta-label { font-size: 9px; opacity: .7; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 2px; }

/* ── Tabla de productos ── */
.checkout-table { width: 100%; border-collapse: collapse; }
.checkout-table th {
    font-size: 12px; font-weight: 600; text-transform: uppercase;
    letter-spacing: .04em; color: var(--t-muted); padding: 8px 10px;
    border-bottom: 1px solid var(--border, #dee2e6);
}
.checkout-table td { padding: 12px 10px; vertical-align: middle; font-size: 14px; }
.checkout-table tr + tr td { border-top: 1px solid var(--border, #dee2e6); }
.checkout-img {
    width: 48px; height: 48px; border-radius: 8px;
    object-fit: cover; background: var(--bg-muted, #f8f9fa);
}

/* Input de tarjeta */
.input-card-wrap { position: relative; }
.card-brand-icon {
    position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
    font-size: 20px; pointer-events: none;
    transition: all .2s;
}
.campo-requerido { border-color: #dc3545 !important; }

/* PASARELA DE PAGO — MODAL OVERLAY */
#pasarelaOverlay {
    position: fixed; inset: 0; z-index: 9999;
    background: rgba(10,12,26,.82);
    backdrop-filter: blur(8px);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity .35s ease;
}
#pasarelaOverlay.show { opacity: 1; pointer-events: all; }

.pasarela-box {
    background: #fff;
    border-radius: 24px;
    padding: 40px 36px;
    width: 100%; max-width: 420px;
    box-shadow: 0 32px 80px rgba(0,0,0,.35);
    text-align: center;
    position: relative;
    animation: boxIn .4s cubic-bezier(.34,1.56,.64,1) both;
}
@@keyframes boxIn { from { transform: scale(.85) translateY(20px); opacity:0; } to { transform: none; opacity:1; } }

/* ── Pantallas ── */
.pg-screen { display: none; }
.pg-screen.active { display: block; }

/* ── Banco header ── */
.pg-bank-header {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid #f0f0f0;
}
.pg-bank-logo {
    width: 42px; height: 42px; border-radius: 10px;
    background: linear-gradient(135deg,#0d6efd,#6610f2);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 20px;
}
.pg-bank-name { font-weight: 700; font-size: 15px; color: #1a1a2e; line-height:1.1; }
.pg-bank-name small { font-weight: 400; font-size: 11px; color: #888; display:block; }

/* ── Spinner procesando ── */
.pg-spinner-wrap { position: relative; width: 90px; height: 90px; margin: 0 auto 24px; }
.pg-spinner-wrap svg { position: absolute; inset: 0; }
.pg-spinner-track { fill: none; stroke: #e8eaf6; stroke-width: 6; }
.pg-spinner-arc {
    fill: none; stroke: url(#pgGrad); stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
    transform-origin: center;
    animation: arcSpin 1.4s ease-in-out infinite;
}
@@keyframes arcSpin {
    0%   { stroke-dashoffset: 200; transform: rotate(0deg); }
    50%  { stroke-dashoffset: 40;  transform: rotate(180deg); }
    100% { stroke-dashoffset: 200; transform: rotate(360deg); }
}
.pg-spinner-icon {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    font-size: 28px; color: #0d6efd;
    animation: pgIconPulse 1.4s ease-in-out infinite;
}
@@keyframes pgIconPulse { 0%,100%{transform:scale(1);opacity:1;} 50%{transform:scale(1.12);opacity:.8;} }

/* ── Barra de progreso ── */
.pg-progress-wrap { margin: 20px 0 16px; }
.pg-progress-bar-bg {
    height: 6px; border-radius: 99px;
    background: #e8eaf6; overflow: hidden;
}
.pg-progress-bar-fill {
    height: 100%; border-radius: 99px;
    background: linear-gradient(90deg,#0d6efd,#6610f2);
    width: 0%; transition: width .6s ease;
}

/* ── Pasos ── */
.pg-steps { display: flex; justify-content: center; gap: 6px; flex-wrap: wrap; margin-top: 14px; }
.pg-step {
    display: flex; align-items: center; gap: 5px;
    font-size: 11px; color: #aaa; padding: 4px 10px;
    border-radius: 99px; background: #f5f5f5;
    transition: all .3s;
}
.pg-step.done  { background: #e8f5e9; color: #2e7d32; }
.pg-step.active { background: #e8eaf6; color: #0d6efd; font-weight: 600; }
.pg-step i { font-size: 12px; }

/* ── Check éxito ── */
.pg-success-circle {
    width: 90px; height: 90px; border-radius: 50%;
    background: linear-gradient(135deg,#00c853,#69f0ae);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
    box-shadow: 0 8px 30px rgba(0,200,83,.35);
    animation: successPop .5s cubic-bezier(.34,1.56,.64,1) both;
}
@@keyframes successPop { from{transform:scale(0);opacity:0;} to{transform:scale(1);opacity:1;} }
.pg-check-icon { font-size: 42px; color: #fff; }
.pg-approval-code {
    font-family: 'Courier New', monospace;
    font-size: 13px; letter-spacing: .1em;
    background: #f5f5f5; border-radius: 8px;
    padding: 8px 16px; display: inline-block;
    margin: 12px 0; color: #444;
}

/* ── Error ── */
.pg-error-circle {
    width: 90px; height: 90px; border-radius: 50%;
    background: linear-gradient(135deg,#e53935,#ff8a65);
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 20px;
    box-shadow: 0 8px 30px rgba(229,57,53,.3);
    animation: errorShake .4s ease both;
}
@@keyframes errorShake {
    0%,100%{transform:translateX(0);}
    20%{transform:translateX(-8px);}
    40%{transform:translateX(8px);}
    60%{transform:translateX(-6px);}
    80%{transform:translateX(6px);}
}
.pg-secure-badge {
    display: flex; align-items: center; justify-content: center;
    gap: 6px; font-size: 11px; color: #888;
    margin-top: 20px; padding-top: 16px;
    border-top: 1px solid #f0f0f0;
}

/* ── Modo Oscuro Overrides ── */
[data-bs-theme="dark"] .pasarela-box {
    background: #1a1c2e;
    color: #f1f5f9;
    box-shadow: 0 32px 80px rgba(0,0,0,.7);
}
[data-bs-theme="dark"] .pg-bank-name { color: #f8fafc !important; }
[data-bs-theme="dark"] .pg-bank-header { border-bottom-color: #2e3248 !important; }
[data-bs-theme="dark"] .pg-secure-badge { border-top-color: #2e3248 !important; color: #94a3b8 !important; }
[data-bs-theme="dark"] .pg-approval-code { background: #25283d !important; color: #69f0ae !important; }
[data-bs-theme="dark"] .pg-step { background: #25283d !important; color: #94a3b8 !important; }
[data-bs-theme="dark"] .pg-step.done { background: rgba(46,125,50,.35) !important; color: #a5d6a7 !important; }
[data-bs-theme="dark"] .pg-step.active { background: rgba(13,110,253,.35) !important; color: #90caf9 !important; }
[data-bs-theme="dark"] #infoSupergiros {
    background: rgba(245, 158, 11, 0.18) !important;
    border-color: rgba(245, 158, 11, 0.45) !important;
    color: #fef08a !important;
}
[data-bs-theme="dark"] #infoSupergiros .text-muted,
[data-bs-theme="dark"] #infoSupergiros small,
[data-bs-theme="dark"] #infoSupergiros p {
    color: #fef08a !important;
}
[data-bs-theme="dark"] #infoContraentrega {
    background: rgba(16, 185, 129, 0.18) !important;
    border-color: rgba(16, 185, 129, 0.45) !important;
    color: #a7f3d0 !important;
}
[data-bs-theme="dark"] #infoContraentrega .text-muted,
[data-bs-theme="dark"] #infoContraentrega small,
[data-bs-theme="dark"] #infoContraentrega p {
    color: #a7f3d0 !important;
}

/* ── Botones de propina ── */
.btn-propina {
    font-size: 11.5px;
    font-weight: 600;
    transition: all .15s ease;
    cursor: pointer;
}
.btn-propina.active {
    background-color: var(--primary, #0d6efd) !important;
    color: #fff !important;
    border-color: var(--primary, #0d6efd) !important;
}
</style>

<div class="container-fluid px-3 px-lg-5">

    <!-- Encabezado -->
    <div class="tienda-page-header">
        <div>
            <h1>
                <i class="bi bi-bag-check-fill text-primary"></i>
                <span>Confirmar Pedido</span>
            </h1>
            <p class="text-muted small mb-0">Revisa tu pedido, elige el método de pago y confirma</p>
        </div>
        <a href="/Tienda/Carrito" class="tienda-back-btn">
            <i class="bi bi-arrow-left"></i>
            <span>Volver al Carrito</span>
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4">

        <!-- ── Columna izquierda ── -->
        <div class="col-lg-7">

            <!-- Productos seleccionados -->
            <div class="carrito-wrap mb-4">
                <div class="pedido-card-header d-flex align-items-center gap-2">
                    <i class="bi bi-bag text-primary"></i>
                    <span class="fw-bold fs-6">Productos del Pedido</span>
                    <span class="badge bg-primary-subtle text-primary ms-auto" id="badgeTotalProductosCheckout">@Model.Count producto(s)</span>
                    <a href="/Tienda/Catalogo" class="btn btn-xs btn-outline-primary rounded-pill py-1 px-2 d-inline-flex align-items-center gap-1" style="font-size:11.5px;">
                        <i class="bi bi-plus-circle"></i> Agregar más
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="checkout-table">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th style="width: 130px; text-align:center;">Cant.</th>
                                <th style="text-align:right;">Precio</th>
                                <th style="text-align:right;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var imgUrl = !string.IsNullOrEmpty(item.Imagen)
                                    ? (item.Imagen.StartsWith("http") ? item.Imagen : (item.Imagen.StartsWith("/") ? item.Imagen : "/" + item.Imagen))
                                    : "";
                                <tr id="checkoutRow-@item.ProductoId"
                                    data-producto-id="@item.ProductoId"
                                    data-precio="@item.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    data-cant="@item.Cantidad"
                                    data-stock="@item.StockDisponible"
                                    data-limite="@(item.LimiteMaximoPorPedido?.ToString() ?? "")"
                                    data-subtotal="@item.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(imgUrl))
                                            {
                                                <img src="@imgUrl" alt="@item.Nombre" class="checkout-img"
                                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                                <div class="checkout-img d-none align-items-center justify-content-center text-muted"
                                                     style="background:var(--bg-muted);border-radius:8px;">
                                                    <i class="bi bi-capsule"></i>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="checkout-img d-flex align-items-center justify-content-center text-muted"
                                                     style="background:var(--bg-muted);border-radius:8px;">
                                                    <i class="bi bi-capsule"></i>
                                                </div>
                                            }
                                            <div>
                                                <span class="carrito-item-name d-block">@item.Nombre</span>
                                                @if (item.LimiteMaximoPorPedido.HasValue && item.LimiteMaximoPorPedido.Value > 0)
                                                {
                                                    <small class="text-muted" style="font-size:11px;">Máx. @item.LimiteMaximoPorPedido.Value /pedido</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td style="text-align:center;" class="text-nowrap">
                                        <div class="d-inline-flex align-items-center justify-content-center gap-1 border rounded-pill px-2 py-1" style="background:var(--bg-muted);">
                                            <button type="button" class="btn btn-sm p-0 text-secondary border-0"
                                                    style="width:20px;height:20px;line-height:1;display:flex;align-items:center;justify-content:center;"
                                                    title="Disminuir cantidad"
                                                    onclick="ajustarCantCheckout('@item.ProductoId', -1)"
                                                    id="btnDecCheckout-@item.ProductoId"
                                                    @(item.Cantidad <= 1 ? "disabled" : "")>
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <span class="fw-bold px-1" style="min-width:22px; font-size:13px;" id="cantCheckout-@item.ProductoId">@item.Cantidad</span>
                                            <button type="button" class="btn btn-sm p-0 text-primary border-0"
                                                    style="width:20px;height:20px;line-height:1;display:flex;align-items:center;justify-content:center;"
                                                    title="Aumentar cantidad"
                                                    onclick="ajustarCantCheckout('@item.ProductoId', 1)"
                                                    id="btnIncCheckout-@item.ProductoId"
                                                    @(item.Cantidad >= item.MaximoPermitido ? "disabled" : "")>
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td style="text-align:right;" class="text-nowrap">$@item.Precio.ToString("N2")</td>
                                    <td style="text-align:right;" class="text-nowrap fw-semibold" id="subtotalCheckout-@item.ProductoId">
                                        $@item.Subtotal.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Dirección de entrega -->
            <div class="carrito-wrap mb-4 p-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-geo-alt-fill text-danger fs-5"></i>
                    <span class="fw-bold">Dirección de Entrega</span>
                </div>
                @{
                    var partesDireccion = direccion.Split('|');
                    var nombreContacto  = partesDireccion.Length > 0 ? partesDireccion[0].Trim() : "";
                    var dirTexto        = partesDireccion.Length > 1 ? partesDireccion[1].Trim() : direccion;
                    var telTexto        = partesDireccion.Length > 2 ? partesDireccion[2].Trim() : "";
                }
                <div class="rounded-3 p-3" style="background:var(--bg-muted);border:1px solid var(--border);">
                    @if (!string.IsNullOrEmpty(nombreContacto))
                    {
                        <div class="fw-semibold small mb-1">@nombreContacto</div>
                    }
                    <div class="text-muted small">@dirTexto</div>
                    @if (!string.IsNullOrEmpty(telTexto))
                    {
                        <div class="text-muted small mt-1">
                            <i class="bi bi-telephone me-1"></i>@telTexto
                        </div>
                    }
                </div>
            </div>

            <!-- ═══════ MÉTODO DE PAGO ═══════ -->
            <div class="carrito-wrap p-3">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="bi bi-credit-card-2-front-fill text-success fs-5"></i>
                    <span class="fw-bold">Método de Pago</span>
                    <span class="text-danger ms-1">*</span>
                </div>

                <div class="d-flex flex-column gap-3">

                    <!-- ── Tarjeta débito / crédito ── -->
                    <div class="pago-card" id="cardTarjeta" onclick="seleccionarPago('tarjeta', this)">
                        <input type="radio" name="_pago" value="tarjeta" id="radioPagoTarjeta" />
                        <div class="d-flex align-items-center gap-3">
                            <div class="pago-check"></div>
                            <div class="d-flex align-items-center gap-3 flex-grow-1">
                                <i class="bi bi-credit-card-fill fs-3 text-primary"></i>
                                <div>
                                    <div class="fw-semibold">Tarjeta Débito o Crédito</div>
                                    <div class="text-muted" style="font-size:12px;">Visa, Mastercard</div>
                                </div>
                                <div class="ms-auto d-flex gap-2 align-items-center">
                                    <!-- Logo Visa SVG inline -->
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 780 500" style="height:22px;" role="img" aria-label="Visa">
                                        <rect width="780" height="500" rx="40" fill="#1a1f71"/>
