                                        <path d="M152.3 153.7H65.5l-.7 4c67.2 16.2 111.7 55.3 130.2 102.3l-18.8-89.7c-3.2-12.4-12.7-16.2-24-16.6z" fill="#f9a533"/>
                                    </svg>
                                    <!-- Logo Mastercard SVG inline -->
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 152.4 108" style="height:22px;" role="img" aria-label="Mastercard">
                                        <rect width="152.4" height="108" rx="8" fill="#252525"/>
                                        <circle cx="60.2" cy="54" r="28" fill="#eb001b"/>
                                        <circle cx="92.2" cy="54" r="28" fill="#f79e1b"/>
