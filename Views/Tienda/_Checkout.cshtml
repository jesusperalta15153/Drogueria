// Formatear número de tarjeta
function formatCardNumber(input) {
    let val = input.value.replace(/\D/g, '').substring(0, 16);
    input.value = val.replace(/(.{4})/g, '$1 ').trim();

    // Actualizar preview
    const formatted = input.value.padEnd(19, '•').replace(/ /g, '').replace(/\d(?=.{5,})/g, '•');
    const groups = input.value ? input.value : '•••• •••• •••• ••••';
    document.getElementById('pvNumber').textContent = groups.padEnd(19).replace(/(.{5})/g, '$1').trim() || '•••• •••• •••• ••••';

    // Detección de marca
    const marca = detectarMarca(input.value);
    marcaDetectada = marca;

    const preview   = document.getElementById('cardPreview');
    const brandEl   = document.getElementById('pvBrand');
    const logoEl    = document.getElementById('pvLogo');
    const iconEl    = document.getElementById('brandIcon');

    preview.classList.remove('visa', 'master');

    if (marca === 'visa') {
        preview.classList.add('visa');
        brandEl.innerHTML = LOGOS.visa;
        logoEl.style.display = 'none'; // usamos innerHTML en brandEl
        iconEl.innerHTML = LOGOS.visa;
    } else if (marca === 'mastercard') {
        preview.classList.add('master');
        brandEl.innerHTML = LOGOS.mastercard;
        logoEl.style.display = 'none'; // usamos innerHTML en brandEl
        iconEl.innerHTML = LOGOS.mastercard;
    } else {
        brandEl.innerHTML = '<span style="letter-spacing:.12em;font-size:11px;opacity:.8;">•••• ••••</span>';
        logoEl.style.display = 'none';
        iconEl.innerHTML = '<i class="bi bi-credit-card text-muted"></i>';
    }

    // Limpiar error
    limpiarError('tcNumero', 'errNumero');
}

// Formatear vencimiento MM/AA
function formatExpiry(input) {
    let val = input.value.replace(/\D/g, '').substring(0, 4);
    if (val.length >= 3) val = val.substring(0, 2) + '/' + val.substring(2);
    input.value = val;
    document.getElementById('pvExp').textContent = val || 'MM/AA';
    limpiarError('tcFecha', 'errFecha');
}

// ─── Seleccionar método principal ────────────────────────────
function seleccionarPago(metodo, card) {
    document.querySelectorAll('.pago-card').forEach(c => c.classList.remove('selected'));
    card.classList.add('selected');

    const infoSG = document.getElementById('infoSupergiros');
    const infoCE = document.getElementById('infoContraentrega');
    if (infoSG) infoSG.style.display = (metodo === 'supergiros') ? 'block' : 'none';
    if (infoCE) infoCE.style.display = (metodo === 'contraentrega') ? 'block' : 'none';

    if (metodo === 'tarjeta') {
        metodoPagoSeleccionado = 'tarjeta-' + subTarjetaSel;
        actualizarResumenPago('Tarjeta de ' + (subTarjetaSel === 'debito' ? 'Débito' : 'Crédito'));
    } else if (metodo === 'supergiros') {
        metodoPagoSeleccionado = 'supergiros';
        actualizarResumenPago('Supergiros (Efectivo en punto)');
    } else if (metodo === 'contraentrega') {
        metodoPagoSeleccionado = 'contraentrega';
        actualizarResumenPago('Pago Contra entrega (Efectivo)');
    }

    document.getElementById('hdnMetodoPago').value = metodoPagoSeleccionado;
    document.getElementById('errorPago').style.display = 'none';
}

// ─── Seleccionar sub-opción de tarjeta ───────────────────────
function seleccionarSubTarjeta(event, tipo) {
    event.stopPropagation();
    subTarjetaSel = tipo;
    document.getElementById('subDebito').classList.toggle('sel', tipo === 'debito');
    document.getElementById('subCredito').classList.toggle('sel', tipo === 'credito');
