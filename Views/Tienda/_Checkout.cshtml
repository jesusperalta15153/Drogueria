                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- Sub-opciones: débito o crédito -->
                        <div class="sub-metodos flex-column flex-sm-row" id="subTarjeta">
                            <div class="sub-btn sel" id="subDebito" onclick="seleccionarSubTarjeta(event,'debito')">
                                <i class="bi bi-wallet2 me-1"></i> Débito
                            </div>
                            <div class="sub-btn" id="subCredito" onclick="seleccionarSubTarjeta(event,'credito')">
                                <i class="bi bi-credit-card me-1"></i> Crédito
                            </div>
                        </div>

                        <!-- ── FORMULARIO DE TARJETA ── -->
                        <div id="formTarjeta" onclick="event.stopPropagation()">

                            <!-- Visualizador -->
                            <div class="card-preview" id="cardPreview">
                                <div class="card-brand-badge">
                                    <span id="pvBrand">•••• ••••</span>
                                    <img id="pvLogo" src="" alt="" style="height:28px; display:none;" />
                                </div>
                                <div class="card-number-preview" id="pvNumber">•••• •••• •••• ••••</div>
                                <div class="card-meta">
                                    <div>
                                        <div class="card-meta-label">Titular</div>
                                        <div id="pvName" style="font-size:13px; font-weight:600;">NOMBRE TITULAR</div>
                                    </div>
                                    <div style="text-align:right;">
                                        <div class="card-meta-label">Vence</div>
                                        <div id="pvExp" style="font-size:13px; font-weight:600;">MM/AA</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Campos -->
                            <div class="row g-3">
                                <!-- Número de tarjeta -->
                                <div class="col-12">
                                    <label class="form-label fw-semibold small">
                                        Número de Tarjeta <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-card-wrap">
                                        <input type="text" id="tcNumero" name="tarjeta_numero"
                                               class="form-control pe-5" maxlength="19"
                                               placeholder="0000 0000 0000 0000"
                                               inputmode="numeric" autocomplete="cc-number"
                                               oninput="formatCardNumber(this)"
                                               onkeypress="return /\d/.test(event.key)" />
                                        <span class="card-brand-icon" id="brandIcon">
                                            <i class="bi bi-credit-card text-muted"></i>
                                        </span>
                                    </div>
                                    <div class="invalid-feedback" id="errNumero"></div>
                                </div>

                                <!-- Nombre del titular -->
                                <div class="col-12">
                                    <label class="form-label fw-semibold small">
                                        Nombre del Titular <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" id="tcNombre" name="tarjeta_titular"
                                           class="form-control" maxlength="60"
                                           placeholder="Tal como aparece en la tarjeta"
                                           autocomplete="cc-name"
                                           oninput="document.getElementById('pvName').textContent = this.value.toUpperCase() || 'NOMBRE TITULAR'" />
                                    <div class="invalid-feedback" id="errNombre"></div>
                                </div>

                                <!-- Vencimiento + CVV -->
                                <div class="col-sm-6">
                                    <label class="form-label fw-semibold small">
                                        Fecha de Vencimiento <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" id="tcFecha" name="tarjeta_vencimiento"
                                           class="form-control" maxlength="5"
                                           placeholder="MM/AA" inputmode="numeric"
                                           autocomplete="cc-exp"
                                           oninput="formatExpiry(this)"
                                           onkeypress="return /[\d\/]/.test(event.key)" />
                                    <div class="invalid-feedback" id="errFecha"></div>
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label fw-semibold small">
                                        Código de Seguridad (CVV) <span class="text-danger">*</span>
                                    </label>
                                    <input type="password" id="tcCvv" name="tarjeta_cvv"
                                           class="form-control" maxlength="4"
                                           placeholder="•••"
                                           inputmode="numeric" autocomplete="cc-csc"
                                           onkeypress="return /\d/.test(event.key)" />
                                    <div class="invalid-feedback" id="errCvv"></div>
                                </div>

                                <!-- Tipo de documento -->
                                <div class="col-sm-5">
                                    <label class="form-label fw-semibold small">
                                        Tipo de Documento <span class="text-danger">*</span>
                                    </label>
                                    <select id="tcTipoDoc" name="tarjeta_tipo_documento" class="form-select">
                                        <option value="">-- Selecciona --</option>
                                        <option value="CC">Cédula de Ciudadanía (CC)</option>
                                        <option value="CE">Cédula de Extranjería (CE)</option>
                                        <option value="PA">Pasaporte (PA)</option>
                                        <option value="NIT">NIT</option>
                                        <option value="TI">Tarjeta de Identidad (TI)</option>
                                    </select>
                                    <div class="invalid-feedback" id="errTipoDoc"></div>
                                </div>

                                <!-- Número de documento -->
                                <div class="col-sm-7">
                                    <label class="form-label fw-semibold small">
                                        Número de Documento <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" id="tcDocumento" name="tarjeta_documento"
                                           class="form-control" maxlength="15"
                                           placeholder="Número de documento"
                                           inputmode="numeric"
                                           onkeypress="return /[\d\-]/.test(event.key)" />
                                    <div class="invalid-feedback" id="errDocumento"></div>
                                </div>
                            </div>
                        </div><!-- /formTarjeta -->
                    </div><!-- /pago-card tarjeta -->

                    <!-- ── Supergiros ── -->
                    <div class="pago-card" id="cardSupergiros" onclick="seleccionarPago('supergiros', this)">
                        <input type="radio" name="_pago" value="supergiros" id="radioPagoSupergiros" />
                        <div class="d-flex align-items-center gap-3">
                            <div class="pago-check"></div>
                            <i class="bi bi-building fs-3 text-warning"></i>
                            <div>
                                <div class="fw-semibold">Supergiros</div>
                                <div class="text-muted" style="font-size:12px;">Pago en efectivo en puntos Supergiros</div>
                            </div>
                            <span class="badge bg-warning-subtle text-warning ms-auto">Efectivo</span>
                        </div>
                        <!-- Box informativo Supergiros -->
                        <div id="infoSupergiros" class="mt-3 p-3 rounded-3 bg-warning-subtle border border-warning" style="display:none;" onclick="event.stopPropagation()">
                            <div class="fw-bold mb-1"><i class="bi bi-info-circle-fill text-warning me-1"></i> Instrucciones de Pago Supergiros</div>
                            <p class="small mb-2">Para realizar el pago en cualquier punto Supergiros, debes dirígete siempre con tu <strong>cédula de ciudadanía original</strong> y tu código de pago permanente:</p>
                            <div class="d-flex align-items-center gap-2">
                                <span class="small">Tu Código de Pago Fijo:</span>
                                <span class="badge bg-warning text-dark font-monospace fs-6 px-3 py-2">@(ViewBag.SupergirosCode ?? "SG-XXXXXXXX")</span>
                            </div>
                            <small class="d-block mt-2 opacity-75" style="font-size: 11px;">* Este código siempre será el mismo para todas tus compras con Supergiros.</small>
                        </div>
                    </div>

                    <!-- ── Pago Contra entrega ── -->
                    <div class="pago-card" id="cardContraentrega" onclick="seleccionarPago('contraentrega', this)">
                        <input type="radio" name="_pago" value="contraentrega" id="radioPagoContraentrega" />
                        <div class="d-flex align-items-center gap-3">
                            <div class="pago-check"></div>
                            <i class="bi bi-cash-stack fs-3 text-success"></i>
                            <div>
                                <div class="fw-semibold">Pago Contra entrega</div>
                                <div class="text-muted" style="font-size:12px;">Paga en efectivo al recibir tu pedido</div>
                            </div>
                            <span class="badge bg-success-subtle text-success ms-auto">Efectivo al recibir</span>
                        </div>
                        <!-- Box informativo Contraentrega -->
                        <div id="infoContraentrega" class="mt-3 p-3 rounded-3 bg-success-subtle border border-success" style="display:none;" onclick="event.stopPropagation()">
                            <div class="fw-bold mb-1"><i class="bi bi-truck text-success me-1"></i> Instrucciones de Pago Contra entrega</div>
                            <p class="small mb-0">Pagas directamente en efectivo al repartidor al recibir tu compra. Al confirmar tu pedido se generará un <strong>código de seguridad único</strong> que deberás entregar al domiciliario para confirmar la entrega.</p>
                        </div>
                    </div>
                </div>

                <div id="errorPago" class="text-danger small mt-2" style="display:none;">
                    <i class="bi bi-exclamation-circle me-1"></i>Selecciona un método de pago.
                </div>
            </div>

        </div><!-- /col-lg-7 -->

        <!-- ── Resumen del pedido ── -->
        <div class="col-lg-5">
            <div class="pedido-card" style="position:sticky; top:20px;">
                <div class="pedido-card-header">
                    <span class="fw-bold fs-6">Resumen del Pedido</span>
                    <i class="bi bi-receipt text-primary"></i>
                </div>
                <div class="pedido-card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal (@Model.Count producto(s))</span>
                        <span class="fw-semibold" id="resumenSubtotalVal">$@subtotal.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="d-flex align-items-center gap-1">
                            <span class="text-muted">Envío</span>
                            @if (costoEnvio == 0)
                            {
                                <span class="badge bg-success-subtle text-success small" style="font-size:10px;">&gt; $45.000</span>
                            }
                        </div>
                        <span id="resumenEnvioVal" class="@(costoEnvio == 0 ? "text-success fw-semibold" : "fw-semibold")">
                            @(costoEnvio == 0 ? "Gratis" : "$" + costoEnvio.ToString("N2"))
                        </span>
                    </div>

                    <div id="bannerEnvioCheckout" class="alert @(costoEnvio == 0 ? "alert-success" : "alert-warning") py-1 px-2 mb-3 d-flex align-items-center gap-2" style="font-size: 11.5px;">
                        @if (costoEnvio == 0)
                        {
                            <i class="bi bi-truck text-success fs-6"></i>
                            <div><strong>¡Envío Gratis!</strong> Por compra mayor a $45.000.</div>
                        }
                        else
                        {
                            <i class="bi bi-info-circle-fill text-warning fs-6"></i>
                            <div>Envío estándar <strong>$8.000</strong> (Gratis en compras superiores a $45.000).</div>
                        }
                    </div>

                    <!-- ── Propina voluntaria ── -->
                    <div class="p-3 rounded-3 mb-3" style="background:var(--bg-muted); border:1px solid var(--border);">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="fw-semibold small d-flex align-items-center gap-1">
                                <i class="bi bi-heart-fill text-danger"></i> Propina al repartidor
                            </span>
                            <span class="fw-bold small text-primary" id="resumenPropinaBadge">
                                @(propinaInicial == 0 ? "$0.00 (Sin propina)" : "$" + propinaInicial.ToString("N2"))
                            </span>
                        </div>
                        <p class="text-muted mb-2" style="font-size: 11px;">
                            Agradece el servicio de tu domiciliario. Puedes modificar el valor o dejarlo en $0:
                        </p>
                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text fw-bold">$</span>
                            <input type="number" id="inputPropina" class="form-control fw-semibold"
                                   value="@((int)propinaInicial)" min="0" max="500000" step="500" placeholder="0"
                                   onkeydown="prevenirTeclasInvalidasPropina(event)"
                                   oninput="onPropinaInputChange(this)"
                                   onblur="onPropinaBlur(this)" />
                        </div>
                        <div id="errPropinaMsg" class="text-danger small mb-2" style="font-size:11px; display:none;">
                            <i class="bi bi-exclamation-circle me-1"></i>La propina no puede ser negativa ni superar $500,000 COP.
                        </div>
                        <div class="d-flex gap-1 flex-wrap">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill py-0 px-2 btn-propina @(propinaInicial == 0 ? "active" : "")" onclick="setPropina(0)">$0</button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2 btn-propina @(propinaInicial == 1000 ? "active" : "")" onclick="setPropina(1000)">$1,000</button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2 btn-propina @(propinaInicial == 2000 ? "active" : "")" onclick="setPropina(2000)">$2,000</button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2 btn-propina @(propinaInicial == 3000 ? "active" : "")" onclick="setPropina(3000)">$3,000</button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill py-0 px-2 btn-propina @(propinaInicial == 5000 ? "active" : "")" onclick="setPropina(5000)">$5,000</button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Impuestos incluidos</span>
                        <span class="text-muted">$0.00</span>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-5">Total a Pagar</span>
                        <span class="carrito-total-amount" id="resumenTotalAPagar">$@total.ToString("N2")</span>
                    </div>

                    <!-- Resumen método seleccionado -->
                    <div id="resumenPago" class="rounded-3 p-3 mb-3"
                         style="background:var(--bg-muted);border:1px dashed var(--border);display:none;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success"></i>
                            <span class="small fw-semibold" id="resumenPagoTexto"></span>
                        </div>
                    </div>

                    <!-- Formulario de confirmación -->
                    <form id="formConfirmar" method="post" action="/Tienda/RealizarPedido"
                          onsubmit="return confirmarPedido()">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="direccionEntrega" value="@direccion" />
                        <input type="hidden" name="metodoPago"        id="hdnMetodoPago" />
                        <input type="hidden" name="propina"           id="hdnPropina" value="@((int)propinaInicial)" />
                        <input type="hidden" name="marcaTarjeta"      id="hdnMarcaTarjeta" />
                        <!-- Campos de tarjeta que se copian al form principal al confirmar -->
                        <input type="hidden" name="tarjeta_numero"           id="hdnTarjetaNumero" />
                        <input type="hidden" name="tarjeta_titular"          id="hdnTarjetaTitular" />
                        <input type="hidden" name="tarjeta_vencimiento"      id="hdnTarjetaVencimiento" />
                        <input type="hidden" name="tarjeta_cvv"              id="hdnTarjetaCvv" />
                        <input type="hidden" name="tarjeta_tipo_documento"   id="hdnTarjetaTipoDoc" />
                        <input type="hidden" name="tarjeta_documento"        id="hdnTarjetaDocumento" />
                        @foreach (var item in Model)
                        {
                            <input type="hidden" name="productosSeleccionados" value="@item.ProductoId" />
                        }
                        <button type="submit"
                                class="btn btn-success w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-bag-check-fill fs-5"></i>
                            <span>Confirmar y Realizar Pedido</span>
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <small class="text-muted d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-shield-lock-fill text-success"></i> Compra segura y garantizada
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════
     MODAL PASARELA DE PAGO SIMULADA
══════════════════════════════════════════════ -->
<div id="pasarelaOverlay" role="dialog" aria-modal="true" aria-label="Pasarela de pago">
    <div class="pasarela-box">

        <!-- Header banco -->
        <div class="pg-bank-header">
            <div class="pg-bank-logo"><i class="bi bi-shield-lock-fill"></i></div>
            <div class="pg-bank-name">
                PaySecure Gateway
                <small>Transacción cifrada SSL 256-bit</small>
            </div>
        </div>

        <!-- ── PANTALLA 1: Procesando ── -->
        <div class="pg-screen active" id="pgProcessing">
            <div class="pg-spinner-wrap">
                <svg viewBox="0 0 90 90" width="90" height="90">
                    <defs>
                        <linearGradient id="pgGrad" x1="0%" y1="0%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="#0d6efd"/>
                            <stop offset="100%" stop-color="#6610f2"/>
                        </linearGradient>
                    </defs>
                    <circle class="pg-spinner-track" cx="45" cy="45" r="38"/>
                    <circle class="pg-spinner-arc" cx="45" cy="45" r="38"/>
                </svg>
                <div class="pg-spinner-icon"><i class="bi bi-credit-card-2-front-fill"></i></div>
            </div>

            <h5 class="fw-bold mb-1">Procesando pago</h5>
            <p class="text-muted small mb-0" id="pgStatusText">Conectando con la red bancaria...</p>

            <div class="pg-progress-wrap">
                <div class="pg-progress-bar-bg">
                    <div class="pg-progress-bar-fill" id="pgProgressFill"></div>
                </div>
            </div>

            <div class="pg-steps">
                <div class="pg-step active" id="pgStep1"><i class="bi bi-lock-fill"></i> Autenticando</div>
                <div class="pg-step" id="pgStep2"><i class="bi bi-bank"></i> Verificando</div>
                <div class="pg-step" id="pgStep3"><i class="bi bi-check2-circle"></i> Confirmando</div>
            </div>
        </div>

        <!-- ── PANTALLA 2: Éxito ── -->
        <div class="pg-screen" id="pgSuccess">
            <div class="pg-success-circle">
                <i class="bi bi-check-lg pg-check-icon"></i>
            </div>
            <h5 class="fw-bold mb-1 text-success">¡Pago Aprobado!</h5>
            <p class="text-muted small">Tu transacción fue procesada exitosamente.</p>
            <div class="pg-approval-code" id="pgApprovalCode">COD: ─────────</div>
            <p class="small text-muted mb-0">Redirigiendo a confirmación del pedido...</p>
        </div>

        <!-- PANTALLA 3: Error -->
        <div class="pg-screen" id="pgError">
            <div class="pg-error-circle">
                <i class="bi bi-x-lg" style="font-size:38px;color:#fff;"></i>
            </div>
            <h5 class="fw-bold mb-1 text-danger">Pago Rechazado</h5>
            <p class="text-muted small" id="pgErrorMsg">No se pudo procesar el pago.</p>
            <div class="d-flex gap-2 justify-content-center mt-3">
                <button class="btn btn-outline-secondary btn-sm rounded-pill px-4"
                        onclick="cerrarPasarela()">Cancelar</button>
                <button class="btn btn-primary btn-sm rounded-pill px-4"
                        onclick="reintentarPago()">Reintentar</button>
            </div>
        </div>

        <!-- Badge seguridad -->
        <div class="pg-secure-badge">
            <i class="bi bi-shield-check text-success"></i>
            Conexión segura · Datos cifrados · PCI DSS
        </div>
    </div>
</div>

@section Scripts {
<script>
// Estado
let metodoPagoSeleccionado = null;   // 'tarjeta-debito' | 'tarjeta-credito' | 'supergiros'
let subTarjetaSel          = 'debito';
let marcaDetectada         = '';     // 'visa' | 'mastercard' | ''

// ── Propina, Envío y Totales dinámicos ──
let _subtotalPedido = @subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
let _envioPedido    = @costoEnvio.ToString(System.Globalization.CultureInfo.InvariantCulture);
let _propinaPedido  = @propinaInicial.ToString(System.Globalization.CultureInfo.InvariantCulture);

function formatCOP(val) {
    return '$' + Number(val).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
}

function recalcularTotalCheckout(syncInput = false) {
    // Validar propina
    if (_propinaPedido < 0) _propinaPedido = 0;
    if (_propinaPedido > 500000) _propinaPedido = 500000;

    // Calcular costo de envío dinámico según subtotal: >= 45.000 es gratis ($0), sino $8.000
    _envioPedido = (_subtotalPedido >= 45000) ? 0 : 8000;

    const total = _subtotalPedido + _envioPedido + _propinaPedido;
    const totalEl = document.getElementById('resumenTotalAPagar');
    if (totalEl) totalEl.textContent = formatCOP(total);

    const subtotalEl = document.getElementById('resumenSubtotalVal');
    if (subtotalEl) subtotalEl.textContent = formatCOP(_subtotalPedido);

    const envioValEl = document.getElementById('resumenEnvioVal');
    if (envioValEl) {
        if (_envioPedido === 0) {
            envioValEl.className = 'text-success fw-semibold';
            envioValEl.textContent = 'Gratis';
        } else {
            envioValEl.className = 'fw-semibold';
            envioValEl.textContent = formatCOP(_envioPedido);
        }
    }

    const badgePropina = document.getElementById('resumenPropinaBadge');
    if (badgePropina) {
        badgePropina.textContent = _propinaPedido === 0 ? '$0.00 (Sin propina)' : formatCOP(_propinaPedido);
    }

    const hdnPropina = document.getElementById('hdnPropina');
    if (hdnPropina) hdnPropina.value = Math.max(0, Math.round(_propinaPedido));

    if (syncInput) {
        const inputPropina = document.getElementById('inputPropina');
        if (inputPropina) inputPropina.value = Math.round(_propinaPedido);
    }

    // Actualizar banner de envío en tiempo real
    const bannerEnvio = document.getElementById('bannerEnvioCheckout');
    if (bannerEnvio) {
        if (_subtotalPedido >= 45000) {
            bannerEnvio.className = 'alert alert-success py-1 px-2 mb-3 d-flex align-items-center gap-2 small';
            bannerEnvio.innerHTML = '<i class="bi bi-truck text-success fs-6"></i><div><strong>¡Envío Gratis!</strong> Por compra mayor a $45.000.</div>';
        } else {
            const falta = 45000 - _subtotalPedido;
            bannerEnvio.className = 'alert alert-warning py-1 px-2 mb-3 d-flex align-items-center gap-2 small';
            bannerEnvio.innerHTML = `<i class="bi bi-info-circle-fill text-warning fs-6"></i><div>Envío estándar <strong>$8.000</strong> (¡Agrega <strong>${formatCOP(falta)}</strong> más para envío gratis!).</div>`;
        }
    }

    // Sincronizar botones de propina activos
    document.querySelectorAll('.btn-propina').forEach(btn => {
        const txt = btn.textContent.replace(/[^\d]/g, '');
        const val = parseInt(txt, 10) || 0;
        if (val === Math.round(_propinaPedido)) {
            btn.classList.add('active');
        } else {
            btn.classList.remove('active');
        }
    });
}

// ── Validación de campo de propina ──
function prevenirTeclasInvalidasPropina(e) {
    if (['-', '+', 'e', 'E'].includes(e.key)) {
        e.preventDefault();
    }
}

function onPropinaInputChange(input) {
    const errEl = document.getElementById('errPropinaMsg');
    let rawVal = input.value;
    
    // Si contiene signo negativo o caracteres inválidos
    if (rawVal.includes('-')) {
        rawVal = rawVal.replace(/-/g, '');
        input.value = rawVal;
    }

    if (rawVal === '') {
        _propinaPedido = 0;
        if (errEl) errEl.style.display = 'none';
        recalcularTotalCheckout(false);
        return;
    }

    let num = parseInt(rawVal, 10);
    if (isNaN(num) || num < 0) {
        num = 0;
        input.value = 0;
    }

    if (num > 500000) {
        num = 500000;
        input.value = 500000;
        if (errEl) errEl.style.display = 'block';
    } else {
        if (errEl) errEl.style.display = 'none';
    }

    _propinaPedido = num;
    recalcularTotalCheckout(false);
}

function onPropinaBlur(input) {
    const errEl = document.getElementById('errPropinaMsg');
    if (errEl) errEl.style.display = 'none';

    let rawVal = input.value.trim();
    if (rawVal === '' || isNaN(parseInt(rawVal, 10))) {
        input.value = 0;
        _propinaPedido = 0;
    } else {
        let num = Math.max(0, parseInt(rawVal, 10));
        if (num > 500000) num = 500000;
        input.value = num;
        _propinaPedido = num;
    }
    recalcularTotalCheckout(true);
}

function setPropina(val) {
    const errEl = document.getElementById('errPropinaMsg');
    if (errEl) errEl.style.display = 'none';

    val = Math.max(0, parseInt(val, 10) || 0);
    if (val > 500000) val = 500000;
    _propinaPedido = val;
    const input = document.getElementById('inputPropina');
    if (input) input.value = val;
    recalcularTotalCheckout(true);
}

// ── Ajustar cantidad directamente desde el Checkout ──
async function ajustarCantCheckout(productoId, delta) {
    const row = document.getElementById(`checkoutRow-${productoId}`);
    if (!row) return;

    let cantActual = parseInt(row.getAttribute('data-cant'), 10) || 1;
    const stock = parseInt(row.getAttribute('data-stock'), 10) || 99;
    const limite = parseInt(row.getAttribute('data-limite'), 10);
    const maxPermitido = (!isNaN(limite) && limite > 0) ? Math.min(stock, limite) : stock;
    const precio = parseFloat(row.getAttribute('data-precio')) || 0;

    const nuevaCant = cantActual + delta;
    if (nuevaCant < 1 || nuevaCant > maxPermitido) return;

    // Actualizar atributos y celdas
    row.setAttribute('data-cant', nuevaCant);
    const nuevoSubtotal = nuevaCant * precio;
    row.setAttribute('data-subtotal', nuevoSubtotal);

    const cantEl = document.getElementById(`cantCheckout-${productoId}`);
    if (cantEl) cantEl.textContent = nuevaCant;

    const subEl = document.getElementById(`subtotalCheckout-${productoId}`);
    if (subEl) subEl.textContent = formatCOP(nuevoSubtotal);

    const btnDec = document.getElementById(`btnDecCheckout-${productoId}`);
    const btnInc = document.getElementById(`btnIncCheckout-${productoId}`);
    if (btnDec) btnDec.disabled = (nuevaCant <= 1);
    if (btnInc) btnInc.disabled = (nuevaCant >= maxPermitido);

    // Sumar subtotales de todas las filas en el checkout
    let sumSubtotal = 0;
    document.querySelectorAll('tr[id^="checkoutRow-"]').forEach(r => {
        sumSubtotal += parseFloat(r.getAttribute('data-subtotal')) || 0;
    });

    _subtotalPedido = sumSubtotal;

    // Recalcular envío, totales y actualizar interfaz automáticamente
    recalcularTotalCheckout(false);

    // Sincronizar cantidad con el carrito en servidor mediante AJAX
    try {
        const formData = new FormData();
        formData.append('productoId', productoId);
        formData.append('cantidad', nuevaCant);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        if (token) formData.append('__RequestVerificationToken', token);
        await fetch('/Tienda/ActualizarCantidad', {
            method: 'POST',
            body: formData,
            headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
        });
    } catch (e) {
        console.error('Error al sincronizar cantidad en servidor:', e);
    }
}

// Detectar marca de tarjeta
function detectarMarca(numero) {
    const limpio = numero.replace(/\s/g, '');
    if (/^4/.test(limpio))                          return 'visa';
    if (/^5[1-5]|^2[2-7]/.test(limpio))            return 'mastercard';
    return '';
}

