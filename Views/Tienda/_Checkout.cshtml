// ─── Helpers de validación visual ────────────────────────────
function marcarError(inputId, errorId, msg) {
    const el = document.getElementById(inputId);
    const er = document.getElementById(errorId);
    if (el) { el.classList.add('is-invalid', 'campo-requerido'); }
    if (er) { er.textContent = msg; er.style.display = 'block'; }
    return false;
}
function limpiarError(inputId, errorId) {
    const el = document.getElementById(inputId);
    const er = document.getElementById(errorId);
    if (el) el.classList.remove('is-invalid', 'campo-requerido');
    if (er) er.style.display = 'none';
}

// ─── Validar campos de tarjeta ───────────────────────────────
function validarCamposTarjeta() {
    let ok = true;

    // Número de tarjeta
    const num = document.getElementById('tcNumero').value.replace(/\s/g, '');
    if (!num) {
        marcarError('tcNumero', 'errNumero', 'El número de tarjeta es obligatorio.'); ok = false;
    } else if (num.length < 13 || num.length > 16) {
        marcarError('tcNumero', 'errNumero', 'El número de tarjeta debe tener entre 13 y 16 dígitos.'); ok = false;
    } else if (!marcaDetectada) {
        marcarError('tcNumero', 'errNumero', 'Solo se aceptan tarjetas Visa o Mastercard.'); ok = false;
    } else { limpiarError('tcNumero', 'errNumero'); }

    // Titular
    const tit = document.getElementById('tcNombre').value.trim();
    if (!tit) {
        marcarError('tcNombre', 'errNombre', 'El nombre del titular es obligatorio.'); ok = false;
    } else if (tit.length < 3) {
        marcarError('tcNombre', 'errNombre', 'Ingresa el nombre completo del titular.'); ok = false;
    } else { limpiarError('tcNombre', 'errNombre'); }

    // Vencimiento MM/AA
    const exp = document.getElementById('tcFecha').value.trim();
    const expRegex = /^(0[1-9]|1[0-2])\/(\d{2})$/;
    if (!exp) {
        marcarError('tcFecha', 'errFecha', 'La fecha de vencimiento es obligatoria.'); ok = false;
    } else if (!expRegex.test(exp)) {
        marcarError('tcFecha', 'errFecha', 'Formato inválido. Usa MM/AA (ej: 08/27).'); ok = false;
    } else {
        const [mes, anio] = exp.split('/').map(Number);
        const hoy  = new Date();
        const expD = new Date(2000 + anio, mes - 1, 1);
        if (expD < new Date(hoy.getFullYear(), hoy.getMonth(), 1)) {
            marcarError('tcFecha', 'errFecha', 'La tarjeta está vencida.'); ok = false;
        } else { limpiarError('tcFecha', 'errFecha'); }
    }

    // CVV
    const cvv = document.getElementById('tcCvv').value.trim();
    if (!cvv) {
        marcarError('tcCvv', 'errCvv', 'El código de seguridad es obligatorio.'); ok = false;
    } else if (!/^\d{3,4}$/.test(cvv)) {
        marcarError('tcCvv', 'errCvv', 'El CVV debe tener 3 o 4 dígitos.'); ok = false;
    } else { limpiarError('tcCvv', 'errCvv'); }

    // Tipo de documento
    const tipoDoc = document.getElementById('tcTipoDoc').value;
    if (!tipoDoc) {
        marcarError('tcTipoDoc', 'errTipoDoc', 'Selecciona el tipo de documento.'); ok = false;
    } else { limpiarError('tcTipoDoc', 'errTipoDoc'); }

    // Número de documento
    const doc = document.getElementById('tcDocumento').value.trim();
    if (!doc) {
        marcarError('tcDocumento', 'errDocumento', 'El número de documento es obligatorio.'); ok = false;
    } else if (doc.length < 5) {
        marcarError('tcDocumento', 'errDocumento', 'El número de documento parece muy corto.'); ok = false;
    } else { limpiarError('tcDocumento', 'errDocumento'); }

    return ok;
}

// Confirmar pedido (submit)
function confirmarPedido() {
    // Sincronizar propina validada
    const inputP = document.getElementById('inputPropina');
    let valP = 0;
    if (inputP) {
        valP = Math.max(0, parseInt(inputP.value.replace(/[^\d]/g, ''), 10) || 0);
        if (valP > 500000) valP = 500000;
        inputP.value = valP;
    } else {
        valP = Math.max(0, Math.round(_propinaPedido));
    }
    const hdnPropina = document.getElementById('hdnPropina');
    if (hdnPropina) hdnPropina.value = valP;

    // 1. Método de pago seleccionado
    if (!metodoPagoSeleccionado) {
        const errEl = document.getElementById('errorPago');
        errEl.style.display = 'block';
        errEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
    }

    // 2. Si es tarjeta → mostrar pasarela simulada (no enviar aún)
    if (metodoPagoSeleccionado.startsWith('tarjeta')) {
        if (!validarCamposTarjeta()) {
            document.getElementById('formTarjeta').scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
        }
        // Copiar valores al form oculto
        document.getElementById('hdnTarjetaNumero').value      = document.getElementById('tcNumero').value.replace(/\s/g,'');
        document.getElementById('hdnTarjetaTitular').value     = document.getElementById('tcNombre').value.trim();
        document.getElementById('hdnTarjetaVencimiento').value = document.getElementById('tcFecha').value.trim();
        document.getElementById('hdnTarjetaCvv').value         = document.getElementById('tcCvv').value.trim();
        document.getElementById('hdnTarjetaTipoDoc').value     = document.getElementById('tcTipoDoc').value;
        document.getElementById('hdnTarjetaDocumento').value   = document.getElementById('tcDocumento').value.trim();
        document.getElementById('hdnMarcaTarjeta').value       = marcaDetectada;
        document.getElementById('hdnMetodoPago').value         = metodoPagoSeleccionado;

        // Abrir modal pasarela
        abrirPasarela();
        return false; // Bloquear submit normal; se enviará desde la pasarela
    }

    // 3. Supergiros → submit directo
    document.getElementById('hdnMetodoPago').value = metodoPagoSeleccionado;
    return true;
}

// PASARELA DE PAGO SIMULADA

const ERRORES_SIMULADOS = [
    'Fondos insuficientes. Verifica el saldo disponible.',
    'Tarjeta bloqueada temporalmente. Contacta tu banco.',
    'Límite de transacciones diarias alcanzado.',
    'Error de comunicación con la red. Intenta nuevamente.',
];

let _pagarReintento = false;

function abrirPasarela() {
    // Resetear pantallas
    mostrarPantallaGateway('pgProcessing');
    resetearPasarela();
    document.getElementById('pasarelaOverlay').classList.add('show');
    simularProcesamiento();
}

function cerrarPasarela() {
    document.getElementById('pasarelaOverlay').classList.remove('show');
}

function reintentarPago() {
    mostrarPantallaGateway('pgProcessing');
    resetearPasarela();
    simularProcesamiento();
}

function mostrarPantallaGateway(id) {
    document.querySelectorAll('.pg-screen').forEach(s => s.classList.remove('active'));
    document.getElementById(id).classList.add('active');
}

function resetearPasarela() {
    document.getElementById('pgProgressFill').style.width = '0%';
    document.getElementById('pgStatusText').textContent = 'Conectando con la red bancaria...';
    ['pgStep1','pgStep2','pgStep3'].forEach((id,i) => {
        const el = document.getElementById(id);
        el.className = 'pg-step' + (i === 0 ? ' active' : '');
    });
}

function simularProcesamiento() {
    const fill    = document.getElementById('pgProgressFill');
    const status  = document.getElementById('pgStatusText');
    const step1   = document.getElementById('pgStep1');
    const step2   = document.getElementById('pgStep2');
    const step3   = document.getElementById('pgStep3');

    // Paso 1 – Autenticando (0 → 35%)
    setTimeout(() => {
        fill.style.width = '35%';
        status.textContent = 'Autenticando datos de la tarjeta...';
    }, 300);

    setTimeout(() => {
        step1.className = 'pg-step done';
        step2.className = 'pg-step active';
        fill.style.width = '60%';
        status.textContent = 'Verificando fondos con el banco emisor...';
    }, 1300);

    setTimeout(() => {
        step2.className = 'pg-step done';
        step3.className = 'pg-step active';
        fill.style.width = '88%';
        status.textContent = 'Confirmando transacción...';
    }, 2400);

    // Resultado final
    setTimeout(() => {
        fill.style.width = '100%';
        step3.className = 'pg-step done';

        // Simular: 90% éxito, 10% rechazo (para parecer realista)
        const aprobado = Math.random() > 0.10;

        setTimeout(() => {
            if (aprobado) {
                mostrarExitoPasarela();
            } else {
                mostrarErrorPasarela();
            }
        }, 400);
    }, 3200);
}

function mostrarExitoPasarela() {
    // Código de aprobación ficticio
    const codigo = 'APR-' + Math.random().toString(36).substring(2,8).toUpperCase();
    document.getElementById('pgApprovalCode').textContent = 'Código: ' + codigo;
    mostrarPantallaGateway('pgSuccess');

    // Enviar el form al servidor tras 2s
    setTimeout(() => {
        document.getElementById('formConfirmar').submit();
    }, 2000);
}

function mostrarErrorPasarela() {
    const msg = ERRORES_SIMULADOS[Math.floor(Math.random() * ERRORES_SIMULADOS.length)];
    document.getElementById('pgErrorMsg').textContent = msg;
    mostrarPantallaGateway('pgError');
}

// ─── Limpiar error en select al cambiar ──────────────────────
document.addEventListener('DOMContentLoaded', () => {
    document.getElementById('tcTipoDoc')?.addEventListener('change',   () => limpiarError('tcTipoDoc',   'errTipoDoc'));
    document.getElementById('tcDocumento')?.addEventListener('input',  () => limpiarError('tcDocumento', 'errDocumento'));
    document.getElementById('tcNombre')?.addEventListener('input',     () => limpiarError('tcNombre',    'errNombre'));
    document.getElementById('tcCvv')?.addEventListener('input',        () => limpiarError('tcCvv',       'errCvv'));
});
