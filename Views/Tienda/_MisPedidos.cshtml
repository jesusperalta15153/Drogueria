@model IEnumerable<Drogueria.Models.Pedido>
@{
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "Mis Pedidos";
    ViewData["ActiveNav"] = "pedidos";
}

<div class="container-fluid px-3 px-lg-5">

    <!-- Encabezado de Página -->
    <div class="tienda-page-header">
        <div>
            <h1>
                <i class="bi bi-clock-history text-primary"></i>
                <span>Historial de Mis Pedidos</span>
            </h1>
            <p class="text-muted small mb-0">Consulta el estado, tiempo estimado de entrega y realiza seguimiento en tiempo real de tus pedidos en camino</p>
        </div>

        <a asp-controller="Tienda" asp-action="Catalogo" class="tienda-back-btn">
            <i class="bi bi-arrow-left"></i>
            <span>Ir al Catálogo</span>
        </a>
    </div>

    <!-- Alertas Flash -->
    @if (TempData["Exito"] != null || TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@(TempData["Exito"] ?? TempData["Success"])</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["CodigoConfirmacion"] != null)
    {
        var metInfo = TempData["MetodoPagoInfo"] as string;
        var codConf = TempData["CodigoConfirmacion"] as string;
        <div class="alert alert-info border-info shadow-sm rounded-3 p-3 mb-4" role="alert">
            <div class="d-flex align-items-center gap-2 fw-bold fs-6 mb-1">
                <i class="bi bi-shield-lock-fill text-primary fs-4"></i>
                <span>¡Pedido Confirmado! Tu Código de Entrega es: <span class="badge bg-primary font-monospace fs-5 px-3 py-1 ms-1">@codConf</span></span>
            </div>
            <p class="mb-1 small">
                <strong>Importante:</strong> Guarda este código de 6 dígitos. Cuando el repartidor llegue a entregarte el pedido, debés darle este código para que él pueda confirmar la entrega en el sistema.
            </p>
            <div class="mt-2 pt-2 border-top border-info border-opacity-25 small fw-semibold text-primary">
                <i class="bi bi-clock-history me-1"></i> Tiempo estimado de entrega: <strong>Máximo en 2 horas</strong>. Te notificaremos cuando el repartidor inicie el recorrido.
            </div>
            @if (metInfo == "supergiros")
            {
                <div class="mt-2 pt-2 border-top border-info border-opacity-25 small">
                    <i class="bi bi-building text-warning me-1"></i>
                    Para realizar el pago en Supergiros, presenta siempre tu <strong>cédula original</strong> en el punto de atención.
                </div>
            }
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="tienda-empty">
            <i class="bi bi-receipt-cutoff"></i>
            <h3>Aún no tienes pedidos registrados</h3>
            <p>Tus pedidos confirmados aparecerán aquí para que puedas hacerles seguimiento.</p>
            <a asp-controller="Tienda" asp-action="Catalogo" class="tienda-empty-btn">
                <i class="bi bi-arrow-left"></i>
                <span>Comenzar a Comprar</span>
            </a>
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-12">

                <style>
                .order-list-card {
                    background: var(--bg-card, #fff);
                    border: 1px solid var(--border, #e2e8f0);
                    border-radius: 16px;
                    display: flex;
                    align-items: center;
                    gap: 0;
                    overflow: hidden;
                    transition: box-shadow .18s, transform .18s;
                    text-decoration: none;
                    color: inherit;
                }
                .order-list-card:hover {
                    box-shadow: 0 6px 24px rgba(0,0,0,.09);
                    transform: translateY(-2px);
                }
                .order-list-card.activo {
                    border-left: 4px solid var(--primary, #7c3aed);
                }
                .order-list-card.en-camino {
                    border-left: 4px solid #f59e0b;
                }
                .order-list-card.entregado {
                    border-left: 4px solid #22c55e;
                }
                .order-list-card.cancelado {
                    border-left: 4px solid #ef4444;
                    opacity: .78;
                }
                .olc-img {
                    width: 90px;
                    height: 90px;
                    object-fit: cover;
                    flex-shrink: 0;
                    background: var(--bg-muted, #f8fafc);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }
                .olc-img img { width: 90px; height: 90px; object-fit: cover; }
                .olc-body {
                    flex: 1;
                    padding: 14px 18px;
                    min-width: 0;
                }
                .olc-actions {
                    padding: 14px 18px;
                    display: flex;
                    flex-direction: column;
                    gap: 8px;
                    flex-shrink: 0;
                    border-left: 1px solid var(--border, #e2e8f0);
                }
                @@media (max-width: 600px) {
                    .order-list-card { flex-direction: column; align-items: stretch; }
                    .olc-img { width: 100%; height: 140px; }
                    .olc-img img { width: 100%; height: 140px; }
                    .olc-actions { border-left: none; border-top: 1px solid var(--border, #e2e8f0); flex-direction: row; }
                }
                </style>

                @foreach (var pedido in Model)
                {
                    var isEnCamino = pedido.Estado == "En camino";
                    var isEntregado = pedido.Estado == "Entregado";
                    var isCancelado = pedido.Estado == "Cancelado";
                    var isActivo = !isEntregado && !isCancelado;

                    var cardClass = isEnCamino ? "en-camino" : isEntregado ? "entregado" : isCancelado ? "cancelado" : "activo";

                    var estadoBadge = pedido.Estado.ToLower() switch
                    {
                        "confirmado"  => ("bg-primary", "bi-circle-fill"),
                        "en camino"   => ("bg-warning text-dark", "bi-truck"),
                        "entregado"   => ("bg-success", "bi-check-circle-fill"),
                        "cancelado"   => ("bg-danger", "bi-x-circle-fill"),
                        _             => ("bg-secondary", "bi-hourglass-split")
                    };

                    // Thumbnail: primer producto con imagen
                    var primerDetalle = pedido.Detalles.FirstOrDefault();
                    var primerProd = primerDetalle?.Producto;
                    var imgUrl = !string.IsNullOrEmpty(primerProd?.Imagen)
                        ? (primerProd.Imagen.StartsWith("http") ? primerProd.Imagen
                           : (primerProd.Imagen.StartsWith("/") ? primerProd.Imagen : "/" + primerProd.Imagen))
                        : "";

                    // Nombre del pedido: primero producto + "y X más"
                    var nombrePedido = primerProd?.Nombre ?? "Medicamentos";
                    var extras = pedido.Detalles.Count - 1;
                    if (extras > 0) nombrePedido += $" y {extras} más";

                    // Producto para "Comprar otra vez"
                    var productoRecompraId = primerProd?.Id;

                    <div class="order-list-card @cardClass mb-3">

                        <!-- Imagen -->
                        <div class="olc-img">
                            @if (!string.IsNullOrEmpty(imgUrl))
                            {
                                <img src="@imgUrl" alt="@(primerProd?.Nombre ?? "Producto")"
                                     onerror="this.style.display='none';this.parentElement.innerHTML='<i class=\'bi bi-capsule text-muted\' style=\'font-size:2rem;\'></i>';" />
                            }
                            else
                            {
                                <i class="bi bi-capsule text-muted" style="font-size:2rem;"></i>
                            }
                        </div>

                        <!-- Cuerpo -->
                        <div class="olc-body">
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                <span class="badge @estadoBadge.Item1 rounded-pill px-2 py-1" style="font-size:11px;">
                                    <i class="bi @estadoBadge.Item2 me-1" style="font-size:9px;"></i>@pedido.Estado
                                </span>
                                @if (isEnCamino && !string.IsNullOrEmpty(pedido.CodigoConfirmacion))
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-25 font-monospace px-2" style="font-size:11px;">
                                        <i class="bi bi-key-fill me-1"></i>@pedido.CodigoConfirmacion
                                    </span>
                                }
                                <span class="text-muted small ms-auto">@pedido.Fecha.ToString("dd/MM/yyyy · HH:mm")</span>
                            </div>

                            <div class="fw-bold text-dark mb-1" style="font-size:15px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:340px;">
                                @nombrePedido
                            </div>

                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                <span class="text-muted small">
                                    <i class="bi bi-hash me-1"></i>#@pedido.Id.ToString().Substring(0, 8).ToUpper()
                                </span>
                                <span class="fw-bold text-primary">$@pedido.Total.ToString("N2")</span>
                                @if (pedido.Detalles.Count > 0)
                                {
                                    <span class="text-muted small">@pedido.Detalles.Sum(d => d.Cantidad) unidades · @pedido.Detalles.Count producto(s)</span>
                                }
                            </div>
                        </div>

                        <!-- Botones -->
                        <div class="olc-actions">
                            <a asp-controller="Tienda" asp-action="DetallePedido" asp-route-id="@pedido.Id"
                               class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-1" style="white-space:nowrap;">
                                <i class="bi bi-eye-fill"></i> Ver compra
                            </a>
                            @if (productoRecompraId.HasValue)
                            {
                                <a asp-controller="Tienda" asp-action="Catalogo" asp-route-abrirProducto="@productoRecompraId"
                                   class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-1" style="white-space:nowrap;">
                                    <i class="bi bi-arrow-repeat"></i> Comprar otra vez
                                </a>
                            }
                        </div>

                    </div>
                }
            </div>
        </div>
    }
</div>

